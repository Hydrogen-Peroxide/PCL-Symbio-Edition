<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>PaperConnect.Core</RootNamespace>
        <AssemblyName>Multiplayer.Protocol</AssemblyName>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
    </PropertyGroup>

    <PropertyGroup>
        <Description>PaperConnect 协议层：联机码、控制面 TCP（c:ping / c:player）、EasyTier 对端模型。不依赖 WPF 与启动器。</Description>
        <PackageId>PCL.Multiplayer.Protocol</PackageId>
    </PropertyGroup>

</Project>

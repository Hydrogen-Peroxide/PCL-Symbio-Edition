<local:MyPageLeft x:Class="PCL.PageGameLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
                  mc:Ignorable="d" x:Name="PanBack"
                  Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- 版本切换开关：Java 与基岩版共用同一个启动入口 -->
        <Border x:Name="PanSwitch" Grid.Row="0" Height="40" Margin="16,10,16,6"
                CornerRadius="12" ClipToBounds="True"
                Background="{DynamicResource GlassControlBrush}"
                BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1"
                MouseEnter="PanSwitch_MouseEnter">
            <Grid>
                <!-- 滑动的选中块 -->
                <Border x:Name="ShapeSwitchThumb" Width="126" Height="36" Margin="1,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="11" IsHitTestVisible="False"
                        Background="{DynamicResource GlassSelectedBrush}"
                        BorderBrush="{DynamicResource GlassAccentBrush}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SwitchThumbPos" X="0" />
                    </Border.RenderTransform>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <svgIcon:SvgIcon x:Name="IcoJava" Icon="lucide/coffee" Width="16" Height="16"
                                         IconBrush="{DynamicResource GlassTextBrush}" />
                        <TextBlock x:Name="LabJava" Text="{DynamicResource Game.Edition.Java}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <svgIcon:SvgIcon x:Name="IcoBedrock" Icon="lucide/box" Width="16" Height="16"
                                         IconBrush="{DynamicResource GlassSecondaryTextBrush}" />
                        <TextBlock x:Name="LabBedrock" Text="{DynamicResource Game.Edition.Bedrock}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassSecondaryTextBrush}" />
                    </StackPanel>

                    <Border x:Name="BtnJavaArea" Grid.Column="0" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="JavaArea_Click" />
                    <Border x:Name="BtnBedrockArea" Grid.Column="1" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="BedrockArea_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- 两个版本各自的左侧面板，切换时只做交叉淡入 -->
        <Grid x:Name="PanHost" Grid.Row="1" />
    </Grid>
</local:MyPageLeft>

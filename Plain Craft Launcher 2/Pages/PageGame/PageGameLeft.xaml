<local:MyPageLeft x:Class="PCL.PageGameLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
                  mc:Ignorable="d" x:Name="PanBack"
                  Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- 版本切换开关：Java 与基岩版共用同一个启动入口 -->
        <Border x:Name="PanSwitch" Grid.Row="0" Height="32" Margin="20,12,20,4"
                CornerRadius="16" ClipToBounds="True"
                Background="{DynamicResource ColorBrushTransparentBackground}"
                ToolTip="{DynamicResource Game.Edition.Switch.ToolTip}"
                MouseEnter="PanSwitch_MouseEnter">
            <Grid>
                <!-- 滑动的选中块 -->
                <Border x:Name="ShapeSwitchThumb" Width="126" Height="28" Margin="2,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="14" IsHitTestVisible="False"
                        Background="{DynamicResource ColorBrush3}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SwitchThumbPos" X="0" />
                    </Border.RenderTransform>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <svgIcon:SvgIcon x:Name="IcoJava" Icon="lucide/coffee" Width="14" Height="14"
                                         IconBrush="{DynamicResource ColorBrushWhite}" />
                        <TextBlock x:Name="LabJava" Text="{DynamicResource Game.Edition.Java}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <svgIcon:SvgIcon x:Name="IcoBedrock" Icon="lucide/box" Width="14" Height="14"
                                         IconBrush="{DynamicResource ColorBrush3}" />
                        <TextBlock x:Name="LabBedrock" Text="{DynamicResource Game.Edition.Bedrock}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush3}" />
                    </StackPanel>

                    <Border x:Name="BtnJavaArea" Grid.Column="0" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="JavaArea_Click" />
                    <Border x:Name="BtnBedrockArea" Grid.Column="1" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="BedrockArea_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- 两个版本各自的左侧面板，切换时只做交叉淡入 -->
        <Grid x:Name="PanHost" Grid.Row="1" />
    </Grid>
</local:MyPageLeft>

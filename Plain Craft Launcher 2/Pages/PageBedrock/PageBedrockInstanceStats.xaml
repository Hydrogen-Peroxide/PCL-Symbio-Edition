<local:MyPageRight x:Class="PCL.PageBedrockInstanceStats"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Bedrock.Instance.Left.Stats}">
                <Grid Margin="25,40,25,15" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BedrockStatsLabel" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Bedrock.Instance.Stats.Size}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabSize" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Bedrock.Instance.Stats.Files}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabFiles" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Bedrock.Instance.Stats.Worlds}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabWorlds" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="6" Text="{DynamicResource Bedrock.Instance.Stats.Created}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabCreated" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="8" Text="{DynamicResource Bedrock.Instance.Stats.Modified}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabModified" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </local:MyCard>

            <Grid Margin="0,0,0,25">
                <local:MyButton x:Name="BtnRefresh" MinWidth="140" Height="35" Padding="13,0"
                                HorizontalAlignment="Left"
                                Text="{DynamicResource Bedrock.Instance.Stats.Refresh}" />
            </Grid>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

<local:MyPageRight x:Class="PCL.PageBedrockRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">

            <!-- 状态 -->
            <!-- 关闭高度动画：启动时进度条出现会让卡片瞬间变高，动画期间会被裁掉一截 -->
            <local:MyCard Title="{DynamicResource Bedrock.Status.Title}" UseAnimation="False">
                <Grid Margin="16,38,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ColorBrush3}">
                        <svgIcon:SvgIcon Icon="lucide/gamepad-2" Width="22" Height="22"
                                         IconBrush="{DynamicResource ColorBrushWhite}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ShapeStatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Fill="{DynamicResource ColorBrushGray4}" />
                            <TextBlock x:Name="LabStatus" Text="{DynamicResource Bedrock.Status.Detecting}"
                                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="LabDetail" Text="{DynamicResource Bedrock.Status.PleaseWait}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   FontSize="12" Margin="0,5,0,0"
                                   MouseLeftButtonUp="LabDetail_Click"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabVersion" Text=""
                                   FontSize="11.5" Margin="0,3,0,0"
                                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray4}" />
                        <!-- 启动进度：与 Java 版启动页一致，镐子敲击动画 + 两列宽度动画进度条 -->
                        <Grid Name="PanLaunchProgress" Margin="0,6,0,0"
                              SnapsToDevicePixels="True" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:MyLoading x:Name="LoadLaunching" Width="60" Height="50"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             AutoRun="False" Text="">
                                <local:MyLoading.LayoutTransform>
                                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                </local:MyLoading.LayoutTransform>
                            </local:MyLoading>
                            <Grid Grid.Column="1" Height="4" Margin="4,0,0,0"
                                  VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Name="ProgressBedrockFinished" Width="0*" />
                                    <ColumnDefinition Name="ProgressBedrockUnfinished" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0" />
                                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6"
                                           RadiusX="2" RadiusY="2" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- 右列只放按钮，宽度固定且不会挤压左侧状态文字 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <local:MyButton x:Name="BtnUpdate" Height="30" Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Bedrock.Action.UpdateToLatest}"
                                        ColorType="Normal" Click="BtnUpdate_Click"
                                        Padding="12,0,12,0"
                                        Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnLaunch" Width="156" Height="42"
                                        Text="{DynamicResource Bedrock.Action.Launch}"
                                        ColorType="Highlight" Click="BtnLaunch_Click"
                                        Padding="16,0,16,0" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <!-- 版本实例 -->
            <local:MyCard Margin="0,12,0,0" Title="{DynamicResource Bedrock.Local.Title}">
                <StackPanel Margin="16,38,16,16">
                    <TextBlock Text="{DynamicResource Bedrock.Local.Description}"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <Grid Margin="0,10,0,0">
                        <local:MyCheckBox x:Name="CheckIsolation" Height="22"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Text="{DynamicResource Bedrock.Isolation.Title}"
                                          ToolTip="{DynamicResource Bedrock.Isolation.Hint}"
                                          Change="CheckIsolation_OnChange" />
                        <local:MyButton x:Name="BtnImport" Text="{DynamicResource Bedrock.Action.Import}"
                                        Height="30" Padding="14,0,14,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="ImportPackage_Click" />
                    </Grid>
                    <StackPanel Name="PanLocalVersions" Margin="0,12,0,0" />
                    <!-- 下载路径：安装包与解包后的版本都保存在该目录的 versions 子文件夹中 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Bedrock.Folder.DownloadPath}" FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                            <TextBlock x:Name="LabBedrockPath" FontSize="11.5" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ColorBrushGray4}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyTextButton x:Name="BtnBedrockPathReset"
                                                Text="{DynamicResource Bedrock.Folder.ResetPath}"
                                                FontSize="12" Padding="6,0,6,0" Height="22"
                                                VerticalAlignment="Center" Visibility="Collapsed"
                                                Click="ResetBedrockPath_Click" />
                            <local:MyButton x:Name="BtnBedrockPathChange"
                                            Text="{DynamicResource Bedrock.Folder.ChangePath}"
                                            Height="30" Padding="14,0,14,0" Margin="6,0,0,0"
                                            Click="ChangeBedrockPath_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 搜索 -->
            <local:MySearchBox x:Name="SearchBox" Margin="0,12,0,0" HintText="{DynamicResource Bedrock.Search.Hint}" />

            <!-- 下载 -->
            <local:MyCard Margin="0,12,0,0" Title="{DynamicResource Bedrock.Download.Title}">
                <StackPanel Margin="16,38,16,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:MyRadioButton x:Name="FilterAll" Text="{DynamicResource Bedrock.Filter.All}" ColorType="Highlight" Checked="True" />
                        <local:MyRadioButton x:Name="FilterUwp" Text="{DynamicResource Bedrock.Filter.Uwp}" ColorType="Highlight" Margin="8,0,0,0" />
                        <local:MyRadioButton x:Name="FilterGdk" Text="{DynamicResource Bedrock.Filter.Gdk}" ColorType="Highlight" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- 版本数与来源分列摆放，避免来源文字在窄窗口下压到筛选按钮上 -->
                    <Grid Margin="2,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabVersionSummary" Grid.Column="0" Text="{DynamicResource Bedrock.Download.Loading}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Bedrock.Download.SourceLabel}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                            <local:MyTextButton Text="mcappx.com" FontSize="12" Padding="2,0,2,0" Height="18"
                                                VerticalAlignment="Center"
                                                local:CustomEventService.EventType="OpenUrl"
                                                local:CustomEventService.EventData="https://www.mcappx.com/" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <StackPanel Name="PanVersionList" Margin="0,10,0,0" />

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

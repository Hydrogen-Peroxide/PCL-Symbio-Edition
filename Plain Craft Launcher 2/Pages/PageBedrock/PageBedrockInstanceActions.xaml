<local:MyPageRight x:Class="PCL.PageBedrockInstanceActions"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!-- 常用操作 -->
            <local:MyCard Margin="0,15" Title="{DynamicResource Bedrock.Instance.Actions.Title}">
                <StackPanel Margin="25,40,25,15">
                    <WrapPanel Margin="0,-5,-20,7">
                        <local:MyButton x:Name="BtnOpenFolder" Height="35" MinWidth="140" Padding="13,0"
                                        Margin="0,5,20,0"
                                        Text="{DynamicResource Bedrock.Instance.Overall.OpenFolder}" />
                        <local:MyButton x:Name="BtnCopy" Height="35" MinWidth="140" Padding="13,0"
                                        Margin="0,5,20,0"
                                        Text="{DynamicResource Bedrock.Instance.Actions.Copy}" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Bedrock.Instance.Actions.Hint}" FontSize="11.5"
                               Opacity="0.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>

            <!-- 危险操作 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Bedrock.Instance.Actions.Danger}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Text="{DynamicResource Bedrock.Instance.Settings.Delete.Hint}" FontSize="11.5"
                               Opacity="0.6" TextWrapping="Wrap" />
                    <local:MyButton x:Name="BtnDelete" Margin="0,14,0,0" MinWidth="140" Height="35"
                                    Padding="13,0" HorizontalAlignment="Left" ColorType="Red"
                                    Text="{DynamicResource Bedrock.Instance.Settings.Delete}" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

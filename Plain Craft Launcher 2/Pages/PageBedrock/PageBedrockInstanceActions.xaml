<local:MyPageRight x:Class="PCL.PageBedrockInstanceActions"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Bedrock.Instance.Actions.Title}">
                <StackPanel Margin="25,40,25,15">
                    <local:MyButton x:Name="BtnOpenFolder" MinWidth="240" Height="40" Padding="24,0"
                                    HorizontalAlignment="Left"
                                    Text="{DynamicResource Bedrock.Instance.Overall.OpenFolder}" />
                    <local:MyButton x:Name="BtnCopy" Margin="0,14,0,0" MinWidth="240" Height="40"
                                    Padding="24,0" HorizontalAlignment="Left"
                                    Text="{DynamicResource Bedrock.Instance.Actions.Copy}" />
                    <local:MyButton x:Name="BtnDelete" Margin="0,14,0,0" MinWidth="240" Height="40"
                                    Padding="24,0" HorizontalAlignment="Left"
                                    Text="{DynamicResource Bedrock.Instance.Settings.Delete}" />
                    <TextBlock Text="{DynamicResource Bedrock.Instance.Actions.Hint}" FontSize="11.5"
                               Opacity="0.5" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
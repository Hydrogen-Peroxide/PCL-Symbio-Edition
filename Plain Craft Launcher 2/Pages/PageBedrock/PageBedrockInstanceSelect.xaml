<local:MyPageRight x:Class="PCL.PageBedrockInstanceSelect"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">
    <Grid Margin="35,18,35,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Bedrock.Select.Instances}" FontSize="14"
                   FontWeight="Bold" Margin="0,0,0,6" />
        <Border Grid.Row="1" Background="{DynamicResource ColorBrushBackground}" CornerRadius="7"
                Padding="14,10,10,10">
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
                <StackPanel x:Name="PanInstances" />
            </local:MyScrollViewer>
        </Border>
    </Grid>
</local:MyPageRight>
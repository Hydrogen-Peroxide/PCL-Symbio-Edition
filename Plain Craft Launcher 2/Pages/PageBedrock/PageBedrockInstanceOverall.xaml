<local:MyPageRight x:Class="PCL.PageBedrockInstanceOverall"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="{StaticResource SePageScrollMargin}">

            <!-- 实例摘要：图标 + 名称 + 通道，右侧直接启动 -->
            <local:MyCard Margin="0,15" Title="" UseAnimation="False">
                <Grid Margin="20,14,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="76" Height="76" CornerRadius="9" Background="#22808080">
                        <Image x:Name="ImgLogo" Margin="10" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LabInstanceName" FontSize="21" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabInstanceSub" FontSize="12.5" Opacity="0.6" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <local:MyButton x:Name="BtnLaunch" Grid.Column="2" ColorType="Highlight"
                                    MinWidth="140" Height="35" Padding="13,0" VerticalAlignment="Center"
                                    Text="{DynamicResource Bedrock.Instance.Overall.Launch}" />
                </Grid>
            </local:MyCard>

            <!-- 实例信息 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Bedrock.Instance.Overall.Info.Title}">
                <Grid Margin="25,40,25,15" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BedrockOverallLabel" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Bedrock.Instance.Overall.Version}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabVersion" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Bedrock.Instance.Overall.Channel}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabChannel" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Bedrock.Instance.Overall.Method}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabMethod" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="6" Text="{DynamicResource Bedrock.Instance.Overall.Path}"
                               VerticalAlignment="Top" Margin="0,5,25,0" />
                    <TextBlock x:Name="LabPath" Grid.Row="6" Grid.Column="1" VerticalAlignment="Top" Margin="0,5,0,0"
                               TextWrapping="Wrap" Opacity="0.75" FontSize="12.5" />
                    <TextBlock Grid.Row="8" Text="{DynamicResource Bedrock.Instance.Overall.DataFolder}"
                               VerticalAlignment="Top" Margin="0,5,25,0" />
                    <TextBlock x:Name="LabDataFolder" Grid.Row="8" Grid.Column="1" VerticalAlignment="Top"
                               Margin="0,5,0,0" TextWrapping="Wrap" Opacity="0.75" FontSize="12.5" />
                </Grid>
            </local:MyCard>

            <!-- 快捷操作 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Bedrock.Shortcuts.Title}">
                <StackPanel Margin="25,40,25,15">
                    <WrapPanel Margin="0,-5,-20,7">
                        <local:MyButton x:Name="BtnOpenFolder" Height="35" MinWidth="140" Padding="13,0"
                                        Margin="0,5,20,0"
                                        Text="{DynamicResource Bedrock.Instance.Overall.OpenFolder}" />
                        <local:MyButton x:Name="BtnOpenSaves" Height="35" MinWidth="140" Padding="13,0"
                                        Margin="0,5,20,0"
                                        Text="{DynamicResource Bedrock.Shortcuts.OpenSaves}" />
                        <local:MyButton x:Name="BtnOpenPackages" Height="35" MinWidth="140" Padding="13,0"
                                        Margin="0,5,20,0"
                                        Text="{DynamicResource Bedrock.Shortcuts.OpenPackages}" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <TextBlock x:Name="LabEmpty" Visibility="Collapsed" Margin="2,0,0,25" Opacity="0.6"
                       TextWrapping="Wrap" Text="{DynamicResource Bedrock.Instance.None}" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

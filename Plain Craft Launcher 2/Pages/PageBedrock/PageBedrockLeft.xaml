<local:MyPageLeft x:Class="PCL.PageBedrockLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL" xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
                  mc:Ignorable="d" x:Name="PanBack"
                  Width="300" AnimatedControl="{Binding ElementName=PanSide, Mode=OneWay}">
    <Grid Name="PanRoot">
        <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>

        <!-- 账号与状态（可滚动） -->
        <local:MyScrollViewer Grid.Row="0" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" Margin="20,0,10,0"
                              Style="{StaticResource ScrollViewerFullMargin}">
            <Grid Margin="0,52,0,0">
                <StackPanel x:Name="PanSide" VerticalAlignment="Center">
                <!-- 账号：大头像居中 + 名称 + 副标题，与 Java 版一致 -->
                <Grid Margin="0,52,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse x:Name="ShapeAvatar" Fill="{DynamicResource ColorBrush3}" />
                            <TextBlock x:Name="LabAvatar" Text="?" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrushWhite}" />
                        </Grid>
                        <TextBlock x:Name="LabGamertag" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Text="{DynamicResource Bedrock.Account.Loading}" FontSize="18" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabAccountMail" Margin="0,3,0,0" HorizontalAlignment="Center"
                                   Text="" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray4}" />
                    </StackPanel>
                </Grid>

                <local:MyIconButton x:Name="BtnSwitchAccount" Height="24" Margin="0,10,0,0" HorizontalAlignment="Center" SvgIcon="lucide/arrow-left-right" ToolTip="{DynamicResource Bedrock.Account.SwitchShort}" ToolTipService.Placement="Center" ToolTipService.VerticalOffset="35" ToolTipService.InitialShowDelay="50" Click="BtnSwitchAccount_Click" />


                <TextBlock Visibility="Collapsed" x:Name="LabAccountHint" Margin="3,8,3,0" FontSize="10.5" TextWrapping="Wrap"
                           Text="{DynamicResource Bedrock.Account.Hint}"
                           Foreground="{DynamicResource ColorBrushGray4}" />
                <local:MyIconButton x:Name="BtnRefreshAccount" Height="26" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    SvgIcon="lucide/refresh-cw" LogoScale="0.85"
                                    ToolTip="{DynamicResource Bedrock.Account.Refresh}" Click="RefreshAccount_Click" />
            </StackPanel>
            </Grid>
        </local:MyScrollViewer>

        <!-- 启动按钮 -->
        <Grid Grid.Row="1" Margin="0,10,0,0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Grid.RenderTransform>
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0"
                            Text="{DynamicResource Bedrock.Action.Launch}"
                            Click="BtnLaunch_Click"
                            Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersionText" Text="{DynamicResource Bedrock.Status.NotSelected}" Margin="35,0,35,10"
                       IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" />
        </Grid>

        <!-- 实例选择 / 实例设置：与 Java 版底部同款并排两个按钮 -->
        <Grid Grid.Row="2" Margin="20,12,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnInstance" Grid.Column="0" Height="32"
                            Text="{DynamicResource Bedrock.Instance.SelectButton}" Click="BtnInstance_Click" />
            <local:MyButton x:Name="BtnInstanceSettings" Grid.Column="2" Height="32"
                            Text="{DynamicResource Bedrock.Instance.Settings}" Click="BtnInstanceSettings_Click" />
        </Grid>

        <!-- 实例设置：以整窗浮层显示，左导航 + 右内容，避免挤在 300px 左栏里 -->
        <Border x:Name="PanInstanceSettings" Grid.RowSpan="4" Background="#00000000" Visibility="Collapsed">
            <Border Background="{DynamicResource ColorBrushBackground}" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左导航 -->
                    <StackPanel Grid.Column="0" Margin="10,14,6,14">
                        <TextBlock x:Name="LabSettingsTabTitle" FontSize="15" FontWeight="Bold"
                                   Margin="6,0,0,2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabSettingsTabSub" FontSize="11" Margin="6,0,0,10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray4}" />
                        <local:MyListItem x:Name="NavDetail" Height="34" Type="RadioBox"
                                          Title="{DynamicResource Bedrock.Instance.Tab.Detail}" SvgIcon="lucide/info"
                                          Click="SettingsTab_Click" />
                        <local:MyListItem x:Name="NavLoader" Height="34" Type="RadioBox"
                                          Title="{DynamicResource Bedrock.Instance.LoaderTitle}" SvgIcon="lucide/package"
                                          Click="SettingsTab_Click" />
                        <local:MyListItem x:Name="NavData" Height="34" Type="RadioBox"
                                          Title="{DynamicResource Bedrock.Instance.Tab.Data}" SvgIcon="lucide/folder-open"
                                          Click="SettingsTab_Click" />
                        <local:MyListItem x:Name="NavShortcuts" Height="34" Type="RadioBox"
                                          Title="{DynamicResource Bedrock.Shortcuts.Title}" SvgIcon="lucide/wrench"
                                          Click="SettingsTab_Click" />
                    </StackPanel>

                    <!-- 右内容 -->
                    <Grid Grid.Column="1" Margin="0,14,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- 实例详情 -->
                                <StackPanel x:Name="PanSettingsDetail">
                                    <TextBlock x:Name="LabSettingsTarget" FontSize="15" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LabSettingsVersion" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LabSettingsPath" Margin="0,2,0,0" FontSize="11"
                                               Foreground="{DynamicResource ColorBrushGray4}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                            CornerRadius="5" Padding="12,10" Margin="0,14,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ShapeStatusDot" Width="8" Height="8" Margin="0,0,7,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource ColorBrushGray4}" />
                                                <TextBlock x:Name="LabStatus"
                                                           Text="{DynamicResource Bedrock.Status.Detecting}"
                                                           FontSize="13" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock x:Name="LabDetail" Text="" FontSize="10.5" Margin="15,4,0,0"
                                                       TextWrapping="Wrap" MouseLeftButtonUp="LabDetail_Click"
                                                       Foreground="{DynamicResource ColorBrushGray4}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 加载器 -->
                                <StackPanel x:Name="PanSettingsLoader" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Bedrock.Instance.LoaderTitle}" FontSize="15"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{DynamicResource Bedrock.Instance.LoaderHint}" Margin="0,4,0,10"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ColorBrushGray4}" />
                                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                            CornerRadius="5" Padding="12,10">
                                        <StackPanel>
                                            <local:MyRadioBox x:Name="RadioVanilla" Margin="0,0,0,10"
                                                              Text="{DynamicResource Bedrock.Loader.Vanilla}" />
                                            <local:MyRadioBox x:Name="RadioLeviLamina" Margin="0,0,0,10"
                                                              Text="{DynamicResource Bedrock.Loader.LeviLamina}" />
                                            <local:MyRadioBox x:Name="RadioBLoader"
                                                              Text="{DynamicResource Bedrock.Loader.BLoader}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 数据与存档 -->
                                <StackPanel x:Name="PanSettingsData" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Bedrock.Instance.Tab.Data}" FontSize="15"
                                               FontWeight="Bold" />
                                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                            CornerRadius="5" Padding="4" Margin="0,10,0,0">
                                        <StackPanel>
                                            <local:MyListItem Height="34" Type="Clickable" IsScaleAnimationEnabled="False"
                                                              Title="{DynamicResource Bedrock.Shortcuts.OpenSaves}"
                                                              SvgIcon="lucide/folder-open" Click="OpenSavesFolder_Click" />
                                            <local:MyListItem Height="34" Type="Clickable" IsScaleAnimationEnabled="False"
                                                              Title="{DynamicResource Bedrock.Shortcuts.BackupWorlds}"
                                                              SvgIcon="lucide/download" Click="BackupWorlds_Click" />
                                            <local:MyListItem Height="34" Type="Clickable" IsScaleAnimationEnabled="False"
                                                              Title="{DynamicResource Bedrock.Shortcuts.OpenScreenshots}"
                                                              SvgIcon="lucide/image" Click="OpenScreenshotFolder_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                            CornerRadius="5" Padding="4" Margin="0,10,0,0">
                                        <StackPanel>
                                            <local:MyListItem Height="34" Type="Clickable" IsScaleAnimationEnabled="False"
                                                              Title="{DynamicResource Bedrock.Shortcuts.OpenPackages}"
                                                              SvgIcon="lucide/box" Click="OpenPackageFolder_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 快捷操作 -->
                                <StackPanel x:Name="PanSettingsShortcuts" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Bedrock.Shortcuts.Title}" FontSize="15"
                                               FontWeight="Bold" />
                                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                            CornerRadius="5" Padding="4" Margin="0,10,0,0">
                                        <StackPanel>
                                            <local:MyListItem Height="34" Type="Clickable" IsScaleAnimationEnabled="False"
                                                              Title="{DynamicResource Bedrock.Editor.Open}"
                                                              SvgIcon="lucide/pencil" Click="OpenEditor_Click" />
                                            <local:MyListItem Height="34" Type="Clickable" IsScaleAnimationEnabled="False"
                                                              Title="{DynamicResource Bedrock.Shortcuts.OpenXbox}"
                                                              SvgIcon="lucide/play" Click="OpenXboxApp_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <local:MyButton Height="32" Width="96" Text="{DynamicResource Common.Action.Close}"
                                            Click="BtnInstanceSettingsClose_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
        </Grid>
        <!-- 启动中：Java 版同款面板，与输入区同级，输入区会一起缩放淡出 -->
        <local:CompLaunchingStatus x:Name="PanLaunching" />
    </Grid>
</local:MyPageLeft>

<local:MyPageLeft x:Class="PCL.PageBedrockLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d" x:Name="PanBack"
                  Width="300">
    <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>

        <!-- 启动按钮 -->
        <Grid Grid.ColumnSpan="5" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Grid.RenderTransform>
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0"
                            Text="启动基岩版" ColorType="Highlight"
                            Click="BtnLaunch_Click"
                            Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersion" Text="未选择版本" Margin="35,0,35,10"
                       IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" />
        </Grid>

        <!-- 版本信息区域 -->
        <Grid Grid.ColumnSpan="5" Grid.Row="1" Margin="20,10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LabStatus" Text="基岩版启动器"
                           FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource ColorBrushGray3}" />
                <TextBlock x:Name="LabDetail" Text="请先选择要启动的基岩版版本"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"
                           Foreground="{DynamicResource ColorBrushGray4}" />
            </StackPanel>
        </Grid>
    </Grid>
</local:MyPageLeft>

<UserControl x:Class="PCL.PageSkinLibraryLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SkinLibrarySectionTab" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" CornerRadius="20"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource GlassHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#FF2D8CFF" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#FF62B0FF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" UseLayoutRounding="True">
        <TextBlock Text="{DynamicResource Tools.SkinLibrary.Title}" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource GlassTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Border BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1"
                CornerRadius="24" Padding="3" Background="{DynamicResource GlassControlBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ItemSkins" GroupName="SkinLibrarySection" IsChecked="True"
                             Content="{DynamicResource Tools.SkinLibrary.Section.Skins}"
                             Style="{StaticResource SkinLibrarySectionTab}" Checked="TabChecked" />
                <RadioButton x:Name="ItemCapes" Grid.Column="1" GroupName="SkinLibrarySection"
                             Content="{DynamicResource Tools.SkinLibrary.Section.Capes}"
                             Style="{StaticResource SkinLibrarySectionTab}" Checked="TabChecked" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>


<local:MyPageRight x:Class="PCL.PageToolsDeviceInfo"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Tools.Device.System}">
                <StackPanel Margin="21,36,21,8">
                    <local:MyListItem x:Name="ItemDeviceOs" Height="40" IsHitTestVisible="False"
                                      SvgIcon="lucide/monitor"
                                      Title="{DynamicResource Tools.Device.OS}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.Device.Title}">
                <StackPanel Margin="21,36,21,8">
                    <local:MyListItem x:Name="ItemDeviceCpu" Height="40" IsHitTestVisible="False"
                                      SvgIcon="lucide/cpu"
                                      Title="{DynamicResource Tools.Device.CPU}" />
                    <StackPanel x:Name="PanDeviceGpu" />
                    <local:MyListItem x:Name="ItemDeviceMemory" Height="40" IsHitTestVisible="False"
                                      SvgIcon="lucide/memory-stick"
                                      Title="{DynamicResource Tools.Device.Memory}" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

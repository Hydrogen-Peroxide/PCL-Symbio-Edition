<local:MyPageRight x:Class="PCL.PageToolsSkinLibrary"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15">
                <Grid Margin="24,20,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 当前皮肤 -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="{DynamicResource Tools.SkinLibrary.Current}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <Border Margin="0,12,0,0" Padding="10" CornerRadius="8">
                            <!-- 预览底色不能太深：深色皮肤的手臂、躯干同色，与近黑底色几乎无法区分，会被误看成空隙 -->
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42"
                                                     RadiusX="0.72" RadiusY="0.72">
                                    <GradientStop Color="#3C4149" Offset="0" />
                                    <GradientStop Color="#17181B" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <local:SkinViewer3D x:Name="ViewerCurrent" Height="232" />
                        </Border>
                        <TextBlock x:Name="LabCurrentName" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   MaxWidth="240" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <Grid x:Name="BtnSlimModel" Margin="0,12,0,0" Background="Transparent" Cursor="Hand"
                              ToolTip="{DynamicResource Tools.SkinLibrary.SlimModel.ToolTip}"
                              MouseLeftButtonUp="BtnSlimModel_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SlimTrack" Width="38" Height="20" CornerRadius="10"
                                    BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse x:Name="SlimKnob" Width="14" Height="14" Margin="2,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource ColorBrushWhite}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="SlimKnobOffset" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Tools.SkinLibrary.SlimModel}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray3}" />
                        </Grid>
                        <local:MyButton x:Name="BtnPrimary" Height="34" Margin="0,14,0,0" Padding="14,0"
                                        HorizontalAlignment="Stretch" ColorType="Highlight"
                                        Text="{DynamicResource Tools.SkinLibrary.AddToLibrary}"
                                        Click="BtnPrimary_Click" />
                        <local:MyButton x:Name="BtnRename" Height="32" Margin="0,8,0,0" Padding="12,0"
                                        HorizontalAlignment="Stretch" Visibility="Collapsed"
                                        Text="{DynamicResource Tools.SkinLibrary.Rename}"
                                        Click="BtnRename_Click" />
                        <local:MyButton x:Name="BtnRemove" Height="32" Margin="0,8,0,0" Padding="12,0"
                                        HorizontalAlignment="Stretch" ColorType="Red" Visibility="Collapsed"
                                        Text="{DynamicResource Tools.SkinLibrary.RemoveFromLibrary}"
                                        Click="BtnRemove_Click" />
                        <local:MyTextButton x:Name="BtnChangeCape" Margin="0,14,0,0" HorizontalAlignment="Center"
                                            Text="{DynamicResource Launch.Skin.ChangeCape}"
                                            Click="BtnChangeCape_Click" />
                    </StackPanel>

                    <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrushGray5}" />

                    <!-- 皮肤库 -->
                    <StackPanel Grid.Column="2" Margin="24,0,0,0">
                        <Grid>
                            <TextBlock Text="{DynamicResource Tools.SkinLibrary.Title}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrush1}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <local:MyIconButton x:Name="BtnRefresh" SvgIcon="lucide/refresh-cw"
                                                    ToolTip="{DynamicResource Tools.SkinLibrary.Refresh}"
                                                    Click="BtnRefresh_Click" />
                                <local:MyIconButton x:Name="BtnOpenFolder" SvgIcon="lucide/folder-open"
                                                    Margin="6,0,0,0"
                                                    ToolTip="{DynamicResource Tools.SkinLibrary.OpenFolder}"
                                                    Click="BtnOpenFolder_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Margin="0,10,0,0" Background="{DynamicResource ColorBrushGray5}" />
                        <WrapPanel x:Name="PanSkinList" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabEmpty" Text="{DynamicResource Tools.SkinLibrary.Empty}"
                                   Margin="4,12,0,0" TextWrapping="Wrap" FontSize="12"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

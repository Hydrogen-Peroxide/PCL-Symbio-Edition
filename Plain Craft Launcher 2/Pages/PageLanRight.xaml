<local:MyPageRight x:Class="PCL.PageLanRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="{StaticResource SePageScrollMargin}">

            <!-- 当前房间 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.Lan.Lobby}">
                <StackPanel Margin="21,36,21,18">
                    <TextBlock x:Name="LabRoomCode" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                               Text="{DynamicResource Tools.Lan.Lobby.None}" />
                    <TextBlock x:Name="LabRoomHint" Margin="0,8,0,0" FontSize="12.5" Opacity="0.75"
                               TextWrapping="Wrap" Text="{DynamicResource Tools.Lan.Lobby.None.Hint}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <local:MyButton x:Name="BtnCopyCode" Height="30" Padding="14,0"
                                        Text="{DynamicResource Tools.Lan.CopyCode}"
                                        Click="BtnCopyCode_Click" IsEnabled="False" />
                        <local:MyButton x:Name="BtnCopyAddress" Height="30" Padding="14,0" Margin="10,0,0,0"
                                        Text="{DynamicResource Tools.Lan.CopyAddress}"
                                        Click="BtnCopyAddress_Click" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 使用说明 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.Lan.Help}">
                <StackPanel Margin="21,36,21,18">
                    <TextBlock Text="{DynamicResource Tools.Lan.Help.Host}" FontSize="12.5" TextWrapping="Wrap"
                               LineHeight="21" />
                    <TextBlock Text="{DynamicResource Tools.Lan.Help.Guest}" Margin="0,10,0,0" FontSize="12.5"
                               TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
            </local:MyCard>

            <!-- 第三方组件版权：AGPL 例外要求在界面明显处显示 -->
            <TextBlock x:Name="LabAttribution" Margin="6,0,6,20" FontSize="11" Opacity="0.65"
                       TextWrapping="Wrap" Text="{DynamicResource Tools.Lan.Attribution}" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

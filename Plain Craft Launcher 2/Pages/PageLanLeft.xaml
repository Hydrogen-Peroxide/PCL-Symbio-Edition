<local:MyPageLeft x:Class="PCL.PageLanLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  Width="300">
    <Grid Margin="0,12,0,14" HorizontalAlignment="Left" Width="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态 -->
        <StackPanel Grid.Row="0" Margin="13,6,13,0">
            <TextBlock Text="{DynamicResource Tools.Lan.Status}" Opacity="0.6" FontSize="12" Margin="0,0,0,6" />
            <TextBlock x:Name="LabState" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                       Text="{DynamicResource Tools.Lan.State.Stopped}" />
            <TextBlock x:Name="LabDetail" Margin="0,6,0,0" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap"
                       Text="{DynamicResource Tools.Lan.State.Stopped.Hint}" />
        </StackPanel>

        <!-- 服务开关 -->
        <StackPanel Grid.Row="1" Margin="13,14,13,0">
            <local:MyButton x:Name="BtnStart" Height="34" ColorType="Highlight" HorizontalAlignment="Stretch"
                            Text="{DynamicResource Tools.Lan.Start}" Click="BtnStart_Click" />
            <local:MyButton x:Name="BtnStop" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Text="{DynamicResource Tools.Lan.Stop}" Click="BtnStop_Click" IsEnabled="False" />
            <local:MyButton x:Name="BtnWeb" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Text="{DynamicResource Tools.Lan.OpenWeb}" Click="BtnWeb_Click" IsEnabled="False" />
        </StackPanel>

        <!-- 房间操作 -->
        <StackPanel Grid.Row="2" Margin="13,18,13,0" VerticalAlignment="Top">
            <TextBlock Text="{DynamicResource Tools.Lan.Room}" Opacity="0.6" FontSize="12" Margin="0,0,0,6" />
            <local:MyTextBox x:Name="TextRoom" Height="32"
                             HintText="{DynamicResource Tools.Lan.Room.Hint}" />
            <local:MyButton x:Name="BtnHost" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            ColorType="Highlight" Text="{DynamicResource Tools.Lan.Host}"
                            Click="BtnHost_Click" IsEnabled="False" />
            <local:MyButton x:Name="BtnJoin" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Text="{DynamicResource Tools.Lan.Join}" Click="BtnJoin_Click" IsEnabled="False" />
            <local:MyButton x:Name="BtnCancelRoom" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Text="{DynamicResource Tools.Lan.Cancel}" Click="BtnCancelRoom_Click" IsEnabled="False" />
        </StackPanel>

        <!-- 底部：当前房间码 -->
        <TextBlock x:Name="LabRoom" Grid.Row="3" Margin="13,10,13,6" FontSize="12.5" FontWeight="Bold"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</local:MyPageLeft>

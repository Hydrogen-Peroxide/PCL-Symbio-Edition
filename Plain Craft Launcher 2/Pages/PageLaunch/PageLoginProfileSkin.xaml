<Grid x:Class="PCL.PageLoginProfileSkin" Tag="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PCL"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,34,0,12" Background="{StaticResource ColorBrushTransparent}" Name="PanData">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition />
            <ColumnDefinition Width="16" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Top">
            <local:MySkin HorizontalAlignment="Center" VerticalAlignment="Top" x:Name="Skin"
                          Margin="0,0,0,16" IsHitTestVisible="False" />
            <TextBlock Name="TextName" Text="Username" Margin="8,0" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Name="TextType" Text="AuthType" Margin="8,5,8,0" FontSize="13" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrushGray4}" />
        </StackPanel>
        <local:MyCard Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" x:Name="PanButtons" Opacity="0"
                      CornerRadius="8" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <local:MyIconButton Height="30" Width="30" Margin="0,0,8,0" x:Name="BtnSkinLibrary"
                                    ToolTip="{DynamicResource Tools.SkinLibrary.Title}"
                                    ToolTipService.Placement="Center"
                                    ToolTipService.VerticalOffset="35" ToolTipService.HorizontalOffset="1"
                                    ToolTipService.InitialShowDelay="50"
                                    LogoScale="1.08"
                                    SvgIcon="lucide/shirt"
                                    Click="BtnSkinLibrary_Click" />
                <local:MyIconButton Height="30" Width="30" Margin="0,0,8,0" x:Name="BtnSkinRefresh"
                                    ToolTip="{DynamicResource Launch.Account.ProfileSkin.RefreshSkin}"
                                    ToolTipService.Placement="Center"
                                    ToolTipService.VerticalOffset="35" ToolTipService.HorizontalOffset="1"
                                    ToolTipService.InitialShowDelay="50"
                                    LogoScale="1.08"
                                    SvgIcon="lucide/refresh-cw" />
                <local:MyIconButton Height="30" Width="30" Margin="0,0,8,0" x:Name="BtnEdit"
                                    ToolTip="{DynamicResource Launch.Account.ProfileSkin.EditProfile}"
                                    ToolTipService.Placement="Center" ToolTipService.VerticalOffset="35"
                                    ToolTipService.HorizontalOffset="1" ToolTipService.InitialShowDelay="50"
                                    LogoScale="1.1"
                                    SvgIcon="lucide/pencil">
                    <local:MyIconButton.ContextMenu>
                        <ContextMenu Closed="MenuAccountOptions_Closed" HorizontalOffset="10" VerticalOffset="18">
                            <local:MyMenuItem Click="BtnEditPassword_Click"
                                              Header="{DynamicResource Launch.Account.ProfileSkin.EditPassword}" />
                            <local:MyMenuItem Click="BtnEditName_Click"
                                              Header="{DynamicResource Launch.Account.ProfileSkin.EditUsername}" />
                        </ContextMenu>
                    </local:MyIconButton.ContextMenu>
                </local:MyIconButton>
                <local:MyIconButton Height="30" Width="30" x:Name="BtnSelect" Margin="0"
                                    ToolTip="{DynamicResource Launch.Account.ProfileSkin.SwitchProfile}"
                                    ToolTipService.Placement="Center" ToolTipService.VerticalOffset="35"
                                    ToolTipService.HorizontalOffset="1" ToolTipService.InitialShowDelay="50"
                                    LogoScale="1.15"
                                    SvgIcon="lucide/arrow-right-left" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</Grid>


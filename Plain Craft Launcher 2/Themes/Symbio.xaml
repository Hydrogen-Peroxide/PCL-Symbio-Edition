    <Style x:Key="SyIconAction" TargetType="local:SymbioIconButton" BasedOn="{StaticResource SyGlyphAction}">
        <Style.Triggers>
            <Trigger Property="Theme" Value="White"><Setter Property="Foreground" Value="White" /></Trigger>
            <Trigger Property="Theme" Value="Red"><Setter Property="Foreground" Value="{DynamicResource SyCritical}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SyIconTextAction" TargetType="local:SymbioIconTextAction" BasedOn="{StaticResource SyGlyphAction}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Style.Triggers>
            <Trigger Property="ColorType" Value="Highlight"><Setter Property="Foreground" Value="{DynamicResource SyAccentText}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SySliderRail" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"
                                VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SySlider" TargetType="local:SymbioSlider">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SyFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource SyAccentFill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SymbioSlider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Stretch"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SySliderRail}"
                                              Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="20" Height="20" RenderTransformOrigin=".5,.5" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource SyFlyoutFill}">
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SyAccentFill}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SySliderRail}"
                                              Background="{DynamicResource SyControlStrongStroke}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <Popup x:Name="PART_ValueHint" Placement="Top" PlacementTarget="{Binding ElementName=Thumb}"
                               AllowsTransparency="True" IsHitTestVisible="False" IsOpen="False" VerticalOffset="-4">
                            <Border CornerRadius="{StaticResource SyRadiusControl}" Padding="8,5"
                                    Background="{DynamicResource SyFlyoutFill}" BorderThickness="1" BorderBrush="{DynamicResource SyCardStroke}">
                                <TextBlock Text="{TemplateBinding ValueHint}" Foreground="{DynamicResource SyText}" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SyAccentHover}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value=".5" />
                            <Setter Property="Foreground" Value="{DynamicResource SyAccentDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SySegment" TargetType="local:SymbioSegment">
        <Setter Property="Foreground" Value="{DynamicResource SyText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SyFocusVisual}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SymbioSegment">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource SyRadiusControl}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Marker" Height="2" Width="16" CornerRadius="1" Margin="0,0,0,-2"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{DynamicResource SyAccentFill}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SySubtleHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SySubtlePressed}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SySubtleHover}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" /><Condition Property="ColorType" Value="Highlight" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource SyAccentText}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource SyTextDisabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:SymbioSearchField}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SymbioSearchField}">
                    <Border Background="{DynamicResource SyFrostFill}" BorderBrush="{DynamicResource SyFrostEdge}"
                            BorderThickness="1" CornerRadius="{StaticResource SyRadiusOverlay}" Padding="8,0,3,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="31" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <svgIcon:SvgIcon Width="14" Height="14" Margin="3,0,0,0" HorizontalAlignment="Left"
                                             VerticalAlignment="Center" IsHitTestVisible="False"
                                             IconBrush="{DynamicResource SyTextSecondary}" Icon="lucide/search" />
                            <local:SymbioTextField x:Name="PART_Query" Grid.Column="1" MaxLength="50"
                                                   HasBackground="False" Padding="0" BorderThickness="0"

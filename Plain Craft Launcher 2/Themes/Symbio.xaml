                                                   HintText="{TemplateBinding HintText}" />
                            <local:SymbioIconButton x:Name="PART_Clear" Grid.Column="2" Width="25" Height="26"
                                                    SvgIcon="lucide/x" Theme="Black" IsHitTestVisible="False"
                                                    IsTabStop="False" Opacity="0"
                                                    AutomationProperties.Name="{DynamicResource Common.Action.Clear}" />
                            <local:SymbioButton x:Name="PART_Search" Grid.Column="3" Margin="3,3,0,3" MinWidth="60"
                                                Visibility="{TemplateBinding SearchButtonVisibility}" ColorType="Highlight"
                                                Text="{DynamicResource Common.Action.Search}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SymbioNotice}">
        <Setter Property="CornerRadius" Value="{StaticResource SyRadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SymbioNotice}">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="14,10,0,10" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Ellipse Fill="{TemplateBinding GlyphBackground}" />
                                <Path Data="{TemplateBinding Glyph}" Stroke="{TemplateBinding GlyphStroke}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Content="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}" />
                            <local:SymbioIconButton x:Name="PART_Dismiss" Grid.Column="2" Theme="Black" Margin="0,0,8,0" Height="24" Width="24"
                                                    Visibility="Collapsed" VerticalAlignment="Center" SvgIcon="lucide/x"
                                                    ToolTip="{DynamicResource Common.Hint.DoNotShowAgain}"
                                                    AutomationProperties.Name="{DynamicResource Common.Hint.DoNotShowAgain}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CanClose" Value="True">
                            <Setter TargetName="PART_Dismiss" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasBorder" Value="False">
                            <Setter TargetName="Surface" Property="BorderThickness" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ExpandableSection}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExpandableSection}">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Height="36" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderSurface" CornerRadius="{StaticResource SyRadiusControl}" Background="Transparent"
                                            Padding="10,0,12,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SySubtleHover}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SySubtleHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel>
                                <Path x:Name="PART_Chevron" DockPanel.Dock="Right" Data="M0,0 L5,5 L10,0"
                                      Width="11" Height="6" Margin="10,0,0,0" Stretch="Uniform"
                                      VerticalAlignment="Center" RenderTransformOrigin=".5,.5"
                                      Stroke="{DynamicResource SyTextSecondary}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock Text="{TemplateBinding Header}" FontSize="14" FontWeight="SemiBold" />
                            </DockPanel>
                        </ToggleButton>
                        <ContentPresenter x:Name="PART_Body" ContentSource="Content" ClipToBounds="True" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SyElevatedAction" TargetType="{x:Type local:ElevatedActionBase}">
        <Setter Property="Background" Value="{DynamicResource SyAccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource SyTextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SyAccentElevation}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SyRadiusOverlay}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="52" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SyAccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SyAccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SyAccentDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource SyTextOnAccentDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SyFloatingIconAction" TargetType="{x:Type local:FloatingIconAction}" BasedOn="{StaticResource SyElevatedAction}">
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.VerticalOffset" Value="-6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FloatingIconAction}">
                    <Grid x:Name="PART_Pose" Width="52" HorizontalAlignment="Right">
                        <Grid x:Name="PART_Pulses" IsHitTestVisible="False" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="8" Direction="270" BlurRadius="32" Opacity=".18"
                                                  Color="{DynamicResource SyShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="PART_Progress" Background="#2FFFFFFF" CornerRadius="{TemplateBinding CornerRadius}"
                                VerticalAlignment="Bottom" IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SyProminentAction" TargetType="{x:Type local:ProminentAction}" BasedOn="{StaticResource SyElevatedAction}">
        <Setter Property="Margin" Value="20" />
        <Setter Property="ToolTipService.Placement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProminentAction}">
                    <Border x:Name="PART_Pose" Margin="0,6" Padding="20,0" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="8" Direction="270" BlurRadius="32" Opacity=".18"
                                              Color="{DynamicResource SyShadowColor}" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SyPrimaryRowAction" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource SyRadiusControl}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="HitArea" Property="BorderBrush" Value="{DynamicResource SyAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

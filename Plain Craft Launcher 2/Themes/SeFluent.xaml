<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:PCL"
                    xmlns:controls="clr-namespace:PCL.Core.UI.Controls;assembly=PCL.Core">
    <!-- Geometry in WPF DIPs, aligned to Fluent 2 (controls 4, cards/overlays 8). -->
    <CornerRadius x:Key="SeRadiusXs">2</CornerRadius>
    <CornerRadius x:Key="SeRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="SeRadiusMd">8</CornerRadius>
    <CornerRadius x:Key="SeRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="SeRadiusPill">999</CornerRadius>
    <SolidColorBrush x:Key="SeWallpaperAccent" Color="#FF5269C5" />
    <SolidColorBrush x:Key="SeDarkScrim" Color="#BF1E1E28" />
    <SolidColorBrush x:Key="SeDarkCard" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SeDarkStroke" Color="#29FFFFFF" />
    <Thickness x:Key="SeHairline">1</Thickness>
    <Thickness x:Key="SeFocusLine">2</Thickness>
    <Thickness x:Key="SePageMargin">24</Thickness>
    <Thickness x:Key="SePageScrollMargin">24,24,24,12</Thickness>
    <Thickness x:Key="SeCardGap">0,0,0,16</Thickness>
    <Thickness x:Key="SeCardSectionMargin">20,40,20,16</Thickness>
    <Thickness x:Key="SeButtonPadding">12,0</Thickness>
    <Thickness x:Key="SeSidebarMargin">8,12,8,12</Thickness>
    <Thickness x:Key="SeSidebarLabelMargin">8,12,4,4</Thickness>
    <Thickness x:Key="SeInsetCompact">16</Thickness>
    <Thickness x:Key="SeInsetRegular">20</Thickness>
    <Thickness x:Key="SeTopSm">0,8,0,0</Thickness>
    <Thickness x:Key="SeTopMd">0,12,0,0</Thickness>
    <Thickness x:Key="SeSideMd">12,0,12,0</Thickness>
    <Thickness x:Key="SeLeftSm">8,0,0,0</Thickness>
    <Thickness x:Key="SeLaunchInset">24,8,24,8</Thickness>
    <Thickness x:Key="SeLaunchButtonInset">24,0,24,0</Thickness>
    <Thickness x:Key="SeLaunchButtonContent">24,0,24,12</Thickness>
    <Thickness x:Key="SeLaunchVersionInset">32,0,32,4</Thickness>
    <Thickness x:Key="SeLaunchSecondaryInset">0,8,8,0</Thickness>
    <Thickness x:Key="SeSplitLeft">0,0,24,0</Thickness>
    <Thickness x:Key="SeSplitRight">24,0,0,0</Thickness>
    <sys:Double x:Key="SeCaption">11</sys:Double>
    <sys:Double x:Key="SeBody">12</sys:Double>
    <sys:Double x:Key="SeBodyStrong">13</sys:Double>
    <sys:Double x:Key="SeCardTitle">14</sys:Double>
    <sys:Double x:Key="SeSubtitle">16</sys:Double>
    <sys:Double x:Key="SeTitle">20</sys:Double>
    <sys:Double x:Key="SeHero">24</sys:Double>
    <sys:Double x:Key="SeButtonHeight">32</sys:Double>
    <sys:Double x:Key="SeInputHeight">32</sys:Double>
    <sys:Double x:Key="SePrimaryHeight">44</sys:Double>
    <sys:Double x:Key="SeListHeight">42</sys:Double>
    <sys:Double x:Key="SeCaptionHeight">40</sys:Double>
    <sys:Double x:Key="SeIconSmall">16</sys:Double>
    <sys:Double x:Key="SeIconMedium">20</sys:Double>
    <sys:Double x:Key="SeIconLarge">24</sys:Double>
    <sys:Double x:Key="SeSeparatorSize">1</sys:Double>
    <sys:Double x:Key="SeDisabledOpacity">0.38</sys:Double>
    <sys:Int32 x:Key="SeHoverMilliseconds">120</sys:Int32>
    <sys:Double x:Key="SePressedScale">0.98</sys:Double>
    <GridLength x:Key="SeInputTrack">32</GridLength>
    <GridLength x:Key="SeFilterGap">8</GridLength>

    <Style x:Key="SeFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource SyFocusOuter}"
                            SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource SyFocusInner}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeIconButton" TargetType="local:SymbioIconButton">
        <Setter Property="Height" Value="{StaticResource SeButtonHeight}" />
        <Setter Property="Width" Value="{StaticResource SeButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource SeRadiusSm}" />
    </Style>
    <Style x:Key="SeCard" TargetType="local:WorkspaceCard">
        <Setter Property="Margin" Value="{StaticResource SeCardGap}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SeListItem" TargetType="local:SelectionRow">
        <Setter Property="FontSize" Value="{StaticResource SeBodyStrong}" />
    </Style>
    <Style x:Key="SeSidebarLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="{StaticResource SeSidebarLabelMargin}" />
        <Setter Property="FontSize" Value="{StaticResource SeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SyTextSecondary}" />
    </Style>
    <Style x:Key="SeSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SyText}" />
    </Style>
    <Style x:Key="SeSolidSurface" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource SeRadiusMd}" />
        <Setter Property="BorderThickness" Value="{StaticResource SeHairline}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SyCardStroke}" />
        <Setter Property="Background" Value="{DynamicResource SyFlyoutFill}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SeAcrylic" TargetType="controls:BlurBorder" BasedOn="{StaticResource SeSolidSurface}">
        <Setter Property="BlurRadius" Value="{DynamicResource BlurRadius}" />
        <Setter Property="BlurSamplingRate" Value="{DynamicResource BlurSamplingRate}" />
        <Setter Property="BlurKernelType" Value="{DynamicResource BlurType}" />
        <Setter Property="Background" Value="{DynamicResource SyFrostFill}" />
        <Style.Triggers>
            <!-- The existing advanced-material switch sets the shared radius to zero. -->
            <Trigger Property="BlurRadius" Value="0">
                <Setter Property="Background" Value="{DynamicResource SyFlyoutFill}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SeFluentCard" TargetType="controls:BlurBorder" BasedOn="{StaticResource SeAcrylic}">
        <Setter Property="Background" Value="{DynamicResource SyFrostFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SyFrostEdge}" />
    </Style>
    <Style x:Key="SeSkinTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SyFrostFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SyFrostEdge}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="16" ShadowDepth="4" Direction="270" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransform">
            <Setter.Value><TranslateTransform /></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="24" ShadowDepth="8" Direction="270" />
                    </Setter.Value>
                </Setter>
                <Setter Property="local:SpringOffset.Y" Value="-3" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

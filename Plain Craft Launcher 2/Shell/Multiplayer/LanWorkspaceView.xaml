<local:WorkspacePage x:Class="PCL.LanWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <Grid Margin="{StaticResource SePageScrollMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,12,0" CornerRadius="{StaticResource SyRadiusOverlay}"
                Background="{DynamicResource SyFrostFill}" BorderBrush="{DynamicResource SyFrostEdge}" BorderThickness="1">
            <Grid Margin="0,10,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 状态 -->
                <StackPanel Grid.Row="0" Margin="13,6,13,0">
                    <TextBlock Text="{DynamicResource Tools.Lan.Status}" Opacity="0.6" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock x:Name="LabState" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               Text="{DynamicResource Tools.Lan.State.Stopped}" />
                    <TextBlock x:Name="LabDetail" Margin="0,6,0,0" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap"
                               Text="{DynamicResource Tools.Lan.State.Stopped.Hint}" />
                </StackPanel>

                <!-- 服务开关 -->
                <StackPanel Grid.Row="1" Margin="13,14,13,0">
                    <local:SymbioButton x:Name="BtnStart" Height="34" ColorType="Highlight" HorizontalAlignment="Stretch"
                                    Text="{DynamicResource Tools.Lan.Start}" Click="BtnStart_Click" />
                    <local:SymbioButton x:Name="BtnStop" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Text="{DynamicResource Tools.Lan.Stop}" Click="BtnStop_Click" IsEnabled="False" />
                    <local:SymbioButton x:Name="BtnWeb" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Text="{DynamicResource Tools.Lan.OpenWeb}" Click="BtnWeb_Click" IsEnabled="False" />
                </StackPanel>

                <!-- 房间操作 -->
                <StackPanel Grid.Row="2" Margin="13,18,13,0" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource Tools.Lan.Room}" Opacity="0.6" FontSize="12" Margin="0,0,0,6" />
                    <local:SymbioTextField x:Name="TextRoom" Height="32"
                                     HintText="{DynamicResource Tools.Lan.Room.Hint}" />
                    <local:SymbioButton x:Name="BtnHost" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    ColorType="Highlight" Text="{DynamicResource Tools.Lan.Host}"
                                    Click="BtnHost_Click" IsEnabled="False" />
                    <local:SymbioButton x:Name="BtnJoin" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Text="{DynamicResource Tools.Lan.Join}" Click="BtnJoin_Click" IsEnabled="False" />
                    <local:SymbioButton x:Name="BtnCancelRoom" Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Text="{DynamicResource Tools.Lan.Cancel}" Click="BtnCancelRoom_Click" IsEnabled="False" />
                </StackPanel>

                <!-- 底部：当前房间码 -->
                <TextBlock x:Name="LabRoom" Grid.Row="3" Margin="13,10,13,6" FontSize="12.5" FontWeight="Bold"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel>

                <!-- 当前房间 -->
                <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Tools.Lan.Lobby}">
                    <StackPanel Margin="21,36,21,18">
                        <TextBlock x:Name="LabRoomCode" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                                   Text="{DynamicResource Tools.Lan.Lobby.None}" />
                        <TextBlock x:Name="LabRoomHint" Margin="0,8,0,0" FontSize="12.5" Opacity="0.75"
                                   TextWrapping="Wrap" Text="{DynamicResource Tools.Lan.Lobby.None.Hint}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <local:SymbioButton x:Name="BtnCopyCode" Height="30" Padding="14,0"
                                            Text="{DynamicResource Tools.Lan.CopyCode}"
                                            Click="BtnCopyCode_Click" IsEnabled="False" />
                            <local:SymbioButton x:Name="BtnCopyAddress" Height="30" Padding="14,0" Margin="10,0,0,0"
                                            Text="{DynamicResource Tools.Lan.CopyAddress}"
                                            Click="BtnCopyAddress_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </local:WorkspaceCard>

                <!-- 使用说明 -->
                <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Tools.Lan.Help}">
                    <StackPanel Margin="21,36,21,18">
                        <TextBlock Text="{DynamicResource Tools.Lan.Help.Host}" FontSize="12.5" TextWrapping="Wrap"
                                   LineHeight="21" />
                        <TextBlock Text="{DynamicResource Tools.Lan.Help.Guest}" Margin="0,10,0,0" FontSize="12.5"
                                   TextWrapping="Wrap" LineHeight="21" />
                    </StackPanel>
                </local:WorkspaceCard>

                <!-- 第三方组件版权：AGPL 例外要求在界面明显处显示 -->
                <TextBlock x:Name="LabAttribution" Margin="6,0,6,20" FontSize="11" Opacity="0.65"
                           TextWrapping="Wrap" Text="{DynamicResource Tools.Lan.Attribution}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:WorkspacePage>

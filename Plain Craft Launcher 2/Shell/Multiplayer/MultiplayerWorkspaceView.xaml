<local:WorkspacePage x:Class="PCL.MultiplayerWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：只负责选版本，具体大厅在右栏 -->
        <Border Grid.Column="0" Margin="10,10,6,10" CornerRadius="{StaticResource SyRadiusOverlay}"
                Background="{DynamicResource SyFrostFill}" BorderBrush="{DynamicResource SyFrostEdge}"
                BorderThickness="1">
            <StackPanel Margin="10,14,10,10">
                <TextBlock Text="联机大厅" FontSize="12" Opacity="0.55" Margin="3,0,0,10" />
                <local:SymbioSegment x:Name="SegJava" Text="Java 版" Height="36" HorizontalAlignment="Stretch"
                                     ColorType="Highlight" Check="Segment_Check" />
                <local:SymbioSegment x:Name="SegBedrock" Text="基岩版" Height="36" Margin="0,6,0,0"
                                     HorizontalAlignment="Stretch" ColorType="Highlight" Check="Segment_Check" />
                <TextBlock x:Name="LabRail" Margin="3,16,3,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                           Text="Java 版走陶瓦联机，基岩版走 PaperConnect。" />
                <TextBlock Margin="3,8,3,0" FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                           Text="两版互不互通，选错版本连不上。" />
            </StackPanel>
        </Border>

        <!-- 右栏：按选中项承载对应大厅，切换时淡入而不是整页重建 -->
        <ContentControl Grid.Column="1" x:Name="Host" />
    </Grid>
</local:WorkspacePage>

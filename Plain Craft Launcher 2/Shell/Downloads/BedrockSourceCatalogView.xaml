<local:WorkspacePage x:Class="PCL.BedrockSourceCatalogView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25">
            <local:SymbioSearchField x:Name="SearchBox" Margin="0,15,0,15" SearchButtonVisibility="Visible"
                               HintText="{DynamicResource Download.BedrockLip.SearchHint}" />

            <local:WorkspaceCard Margin="0,0,0,15">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Download.Comp.Filter.Source}" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="5,0" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Download.BedrockLip.Source}" Margin="5,0"
                               VerticalAlignment="Center" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource Download.Comp.Filter.Sort}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,5,0" />
                    <local:SymbioSelect x:Name="ComboSort" Grid.Column="3" MaxDropDownHeight="320"
                                      SelectionChanged="ComboSort_SelectionChanged">
                        <local:SelectOption Content="{DynamicResource Common.Option.Default}" Tag="0"
                                              IsSelected="True" />
                        <local:SelectOption Content="{DynamicResource Download.BedrockLip.Sort.Stars}" Tag="1" />
                        <local:SelectOption Content="{DynamicResource Download.Comp.Sort.Updated}" Tag="2" />
                    </local:SymbioSelect>
                </Grid>
            </local:WorkspaceCard>

            <TextBlock x:Name="LabStatus" Margin="2,0,0,8" FontSize="11.5" Opacity="0.6"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="PanList" />
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

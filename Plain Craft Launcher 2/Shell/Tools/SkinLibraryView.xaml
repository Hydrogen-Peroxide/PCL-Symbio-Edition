<local:WorkspacePage x:Class="PCL.SkinLibraryView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:controls="clr-namespace:PCL.Core.UI.Controls;assembly=PCL.Core"
                   PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,28">
                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="皮肤库" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource SyText}" />
                    <TextBlock Text="管理本地皮肤，预览模型并应用到当前账号。"
                               Margin="0,6,0,0" FontSize="13"
                               Foreground="{DynamicResource SyTextSecondary}" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="292" />
                    </Grid.ColumnDefinitions>

                    <!-- 当前皮肤：只保留预览与名字，操作按钮挪到左栏顶部 -->
                    <controls:BlurBorder Grid.Column="2" Width="304" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SeFluentCard}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Tools.SkinLibrary.Current}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SyText}" />
                        <Border Margin="0,20,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource ColorBrushSemiTransparent}">
                            <!-- 预览底色不能太深：深色皮肤的手臂、躯干同色，与近黑底色几乎无法区分，会被误看成空隙 -->
                            <local:SkinPreviewView x:Name="ViewerCurrent" Height="260" />
                        </Border>
                        <TextBlock x:Name="LabCurrentName" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   MaxWidth="200" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SyTextSecondary}" />
                        <local:SymbioButton x:Name="BtnRename" Height="34" Margin="0,14,0,0" Padding="12,0"
                                        HorizontalAlignment="Stretch" Visibility="Collapsed"
                                        Text="{DynamicResource Tools.SkinLibrary.Rename}"
                                        Click="BtnRename_Click" />
                        <local:SymbioButton x:Name="BtnRemove" Height="34" Margin="0,8,0,0" Padding="12,0"
                                        HorizontalAlignment="Stretch" ColorType="Red" Visibility="Collapsed"
                                        Text="{DynamicResource Tools.SkinLibrary.RemoveFromLibrary}"
                                        Click="BtnRemove_Click" />
                    </StackPanel>
                    </controls:BlurBorder>

                    <!-- 皮肤库 -->
                    <controls:BlurBorder Grid.Column="0" Margin="0,0,0,0" Padding="20"
                                         Style="{StaticResource SeFluentCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="我的皮肤" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SyText}" />
                            <TextBlock Text="导入 PNG 皮肤后，点击卡片即可预览和应用。"
                                       Margin="0,30,0,0" FontSize="12"
                                       Foreground="{DynamicResource SyTextSecondary}" />
                        </Grid>
                        <!-- 顶部工具栏 -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid Width="180" Height="34" VerticalAlignment="Center"
                                      ToolTip="{DynamicResource Tools.SkinLibrary.SlimModel.ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:SymbioButton x:Name="BtnClassicModel" Height="34" Style="{StaticResource SePillButton}"
                                                    Text="{DynamicResource Launch.Skin.Model.Steve}" Click="BtnModel_Click" />
                                    <local:SymbioButton x:Name="BtnSlimModel" Grid.Column="2" Height="34" Style="{StaticResource SePillButton}"
                                                    Text="{DynamicResource Launch.Skin.Model.Alex}" Click="BtnModel_Click" />
                                </Grid>
                                <local:SymbioButton x:Name="BtnPrimary" Height="34" CornerRadius="8"
                                                Margin="8,0,0,0" Padding="12,0" VerticalAlignment="Center"
                                                ColorType="Highlight"
                                                Text="{DynamicResource Tools.SkinLibrary.AddToLibrary}"
                                                Click="BtnPrimary_Click" />
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <local:SymbioIconButton x:Name="BtnRefresh" SvgIcon="lucide/refresh-cw"
                                                    Style="{StaticResource SeIconButton}"
                                                    ToolTip="{DynamicResource Tools.SkinLibrary.Refresh}"
                                                    Click="BtnRefresh_Click" />
                                <local:SymbioIconButton x:Name="BtnOpenFolder" SvgIcon="lucide/folder-open"
                                                    Style="{StaticResource SeIconButton}" Margin="6,0,0,0"
                                                    ToolTip="{DynamicResource Tools.SkinLibrary.OpenFolder}"
                                                    Click="BtnOpenFolder_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="10"
                                Background="{DynamicResource ColorBrushSemiTransparent}">
                            <WrapPanel x:Name="PanSkinList" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="LabEmpty" Text="{DynamicResource Tools.SkinLibrary.Empty}"
                                   Margin="4,12,0,0" TextWrapping="Wrap" FontSize="12"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource SyTextSecondary}" />
                    </StackPanel>
                    </controls:BlurBorder>
                </Grid>
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

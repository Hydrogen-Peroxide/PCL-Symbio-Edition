<local:WorkspacePage x:Class="PCL.HomeContentView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="{StaticResource SePageScrollMargin}" Grid.IsSharedSizeScope="True">
            <StackPanel x:Name="PanCustom" />
            <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.CommunityHint.Title}" x:Name="PanHint" CornerRadius="{StaticResource SeRadiusMd}">
                <local:SymbioIconButton LogoScale="1.1"
                                    SvgIcon="lucide/x"
                                    Height="20" Width="20" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    x:Name="BtnHintClose"
                                    Click="BtnHintClose_Click" />
                <StackPanel Margin="25,38,23,15">
                    <TextBlock x:Name="LabHint1" TextWrapping="Wrap" />
                </StackPanel>
            </local:WorkspaceCard>
            <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog"
                                 CornerRadius="{StaticResource SyRadiusOverlay}" CanSwap="True">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas" />
            </local:WorkspaceCard>
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

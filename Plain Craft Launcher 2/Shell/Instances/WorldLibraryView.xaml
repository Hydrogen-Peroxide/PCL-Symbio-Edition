<local:WorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
    mc:Ignorable="d" x:Class="PCL.WorldLibraryView"
    PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">
    <Grid>
        <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              x:Name="PanBack">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="PanInstanceSelect" Grid.Row="0" Margin="25,30,25,0" Visibility="Collapsed">
                    <Border x:Name="PanVersionCard" Background="{DynamicResource SyControlAlt}"
                            BorderBrush="{DynamicResource SyTextDisabled}" BorderThickness="1"
                            CornerRadius="6" ClipToBounds="True" Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonUp="PanVersionCard_MouseLeftButtonUp"
                            MouseEnter="PanVersionCard_MouseEnter" MouseLeave="PanVersionCard_MouseLeave">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid Height="52" x:Name="PanVersionCardContent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="VersionHover" Grid.ColumnSpan="3" Background="{DynamicResource SySubtleHover}"
                                    Opacity="0" IsHitTestVisible="False" CornerRadius="5" />
                            <local:AssetImage x:Name="ImgVersionLogo" Width="30" Height="30" Margin="14,0,0,0"
                                           VerticalAlignment="Center" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LabVersionTitle" FontSize="14.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LabVersionInfo" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SyTextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <svgIcon:SvgIcon x:Name="IconVersionChevron" Grid.Column="2"
                                             Icon="lucide/chevron-right"
                                             Width="18" Height="18" Margin="0,0,16,0"
                                             VerticalAlignment="Center"
                                             IconBrush="{DynamicResource SyTextSecondary}" IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                <svgIcon:SvgIcon.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </svgIcon:SvgIcon.RenderTransform>
                            </svgIcon:SvgIcon>
                        </Grid>
                    </Border>
                    <Popup x:Name="PopupVersion" PlacementTarget="{Binding ElementName=PanVersionCard}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           VerticalOffset="6"
                           Opened="PopupVersion_Opened" Closed="PopupVersion_Closed">
                        <Border x:Name="PanVersionPopup" Background="{DynamicResource SyFlyoutFill}" CornerRadius="6"
                                Padding="8" RenderTransformOrigin="0.5,0.15"
                                Width="{Binding ActualWidth, ElementName=PanVersionCard}"
                                BorderBrush="{DynamicResource SyTextDisabled}" BorderThickness="1"
                                MaxHeight="360">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.35" BlurRadius="6" ShadowDepth="2" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Instance.Saves.VersionSelect}" FontSize="12"
                                           Margin="6,2,6,6" Foreground="{DynamicResource SyTextSecondary}" />
                                <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="300">
                                    <StackPanel x:Name="PanVersionList" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <Grid Grid.Row="1" x:Name="PanSavesBody" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Grid.RenderTransform>
                <local:WorkspaceCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanNoWorld">
                    <Grid Margin="20,17">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="6" Margin="0,0,0,9" HorizontalAlignment="Center"
                                   Text="{DynamicResource Instance.Saves.Empty.Title}" FontSize="19"
                                   UseLayoutRounding="True" SnapsToDevicePixels="True"
                                   Foreground="{DynamicResource SyAccentText}" />
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="6" HorizontalAlignment="Stretch" Height="2"
                                   Fill="{DynamicResource SyAccentText}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Margin="10,15,10,5"
                                   Text="{DynamicResource Instance.Saves.Empty.Message}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="6" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <local:SymbioButton Height="35" MinWidth="120" Margin="6,0"
                                                Click="BtnOpenFolder_Click"
                                                Text="{DynamicResource Instance.Saves.OpenFolder}"
                                                Padding="13,0" ColorType="Highlight" />
                            <local:SymbioButton Height="35" MinWidth="120" Margin="6,0"
                                                Click="BtnDownloadNew_Click"
                                                Text="{DynamicResource Instance.Resource.DownloadNew}"
                                                Padding="13,0" />
                            <local:SymbioButton Height="35" MinWidth="120" Margin="6,0"
                                                Click="BtnPaste_Click"
                                                Text="{DynamicResource Instance.Saves.PasteFile}"
                                                Padding="13,0" />
                            <local:SymbioButton Height="35" MinWidth="120" Margin="6,0"
                                                Click="BtnConvert_Click"
                                                Text="{DynamicResource Instance.Saves.Convert.Button}"
                                                Padding="13,0" />
                        </WrapPanel>
                    </Grid>
                </local:WorkspaceCard>
                <StackPanel Orientation="Vertical" Margin="25,10,25,10" x:Name="PanContent">
                    <local:SymbioSearchField Margin="0,10,0,15" HintText="{DynamicResource Instance.Saves.SearchHint}"
                                       x:Name="SearchBox" />

                    <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Instance.Saves.QuickActions}">
                        <!-- 用 WrapPanel：窗口窄的时候按钮换行，而不是把第 4 个（转换存档）挤出可视区 -->
                        <WrapPanel Margin="25,40,15,20">
                            <local:SymbioButton MinWidth="120" Height="32" Margin="0,0,12,10"
                                            Text="{DynamicResource Instance.Saves.OpenFolder}" Padding="13,0"
                                            Click="BtnOpenFolder_Click" ColorType="Highlight" />
                            <local:SymbioButton MinWidth="120" Height="32" Margin="0,0,12,10"
                                            Text="{DynamicResource Instance.Resource.DownloadNew}" Padding="13,0"
                                            Click="BtnDownloadNew_Click" />
                            <local:SymbioButton MinWidth="120" Height="32" Margin="0,0,12,10"
                                            Text="{DynamicResource Instance.Saves.PasteFile}" Padding="13,0"
                                            Click="BtnPaste_Click" />
                            <local:SymbioButton MinWidth="120" Height="32" Margin="0,0,12,10"
                                            Text="{DynamicResource Instance.Saves.Convert.Button}" Padding="13,0"
                                            Click="BtnConvert_Click" />
                        </WrapPanel>
                    </local:WorkspaceCard>

                    <local:WorkspaceCard Margin="0,0,0,15" x:Name="PanListBack" VerticalAlignment="Top"
                                  Title="{DynamicResource Instance.Saves.ListTitle}"
                                  MinHeight="55">
                        <Grid>
                            <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top"
                                        HorizontalAlignment="Right" Height="28">
                                <local:SymbioIconTextAction x:Name="BtnSort"
                                                         Text="{DynamicResource Instance.Saves.SortBy}"
                                                         SvgIcon="lucide/arrow-up-down" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="20,48,18,22" Name="PanList" VerticalAlignment="Top" />
                    </local:WorkspaceCard>
                </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="PanMapEditor" Visibility="Collapsed" Margin="{StaticResource SePageScrollMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                <local:SymbioButton Text="{DynamicResource Instance.Saves.MapEditor.Back}" Height="32"
                                Padding="12,0" Click="BtnMapBack_Click" />
            </StackPanel>
            <local:SchematicEditorView x:Name="MapEditor" Grid.Row="1" Margin="0,4,0,0" />
        </Grid>
    </Grid>
</local:WorkspacePage>

<UserControl x:Class="PCL.BedrockFoldersView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL">
    <Grid Margin="6,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Bedrock.Select.FolderList}" Margin="13,6,5,6"
                   Opacity="0.6" FontSize="12" />
        <ScrollViewer local:ScrollInput.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" local:ScrollInput.DeltaMultiplier="0.7"
                              Style="{StaticResource ScrollViewerFullMargin}">
            <StackPanel x:Name="PanFolders" Margin="0,0,6,0" />
        </ScrollViewer>

        <!-- 添加或导入：与 Java 版「实例选择」页一致的列表项样式，固定在左下角 -->
        <StackPanel Grid.Row="2" Margin="0,6,6,0">
            <TextBlock Text="{DynamicResource Select.Folder.AddOrImport}" Margin="13,6,5,4"
                       Opacity="0.6" FontSize="12" />
            <StackPanel x:Name="PanActions" />
        </StackPanel>
    </Grid>
</UserControl>

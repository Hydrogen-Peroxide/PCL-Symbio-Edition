<local:WorkspacePage x:Class="PCL.BedrockPreferencesView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="{StaticResource SePageScrollMargin}">

            <!-- 基本信息 -->
            <local:WorkspaceCard Margin="0,15" Title="{DynamicResource Bedrock.Instance.Settings.Basic}">
                <Grid Margin="25,40,25,15" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BedrockSetupLabel" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Bedrock.Instance.Settings.Rename}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <local:SymbioTextField x:Name="TextName" Grid.Row="0" Grid.Column="1" Height="30"
                                     MaxLength="60" VerticalAlignment="Center" />
                    <local:SymbioButton x:Name="BtnRename" Grid.Row="0" Grid.Column="2" Margin="12,0,0,0"
                                    MinWidth="120" Height="30" Padding="18,0"
                                    Text="{DynamicResource Bedrock.Instance.Settings.RenameAction}" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Bedrock.Instance.Overall.Version}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabVersion" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Bedrock.Instance.Overall.Channel}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabChannel" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </local:WorkspaceCard>

            <!-- 数据位置 -->
            <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Bedrock.Instance.Settings.Location}">
                <Grid Margin="25,40,25,15" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BedrockSetupPathLabel" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Bedrock.Instance.Settings.InstancePath}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabPath" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Opacity="0.75" FontSize="12.5" />
                    <local:SymbioButton x:Name="BtnOpenFolder" Grid.Row="0" Grid.Column="2" Margin="12,0,0,0"
                                    MinWidth="120" Height="30" Padding="18,0"
                                    Text="{DynamicResource Bedrock.Instance.Overall.OpenFolder}" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Bedrock.Instance.Overall.DataFolder}"
                               VerticalAlignment="Center" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabDataFolder" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Opacity="0.75" FontSize="12.5" />
                    <local:SymbioButton x:Name="BtnOpenData" Grid.Row="2" Grid.Column="2" Margin="12,0,0,0"
                                    MinWidth="120" Height="30" Padding="18,0"
                                    Text="{DynamicResource Bedrock.Instance.Settings.OpenData}" />
                </Grid>
            </local:WorkspaceCard>

            <!-- 危险操作 -->
            <local:WorkspaceCard Margin="0,0,0,15" Title="{DynamicResource Bedrock.Instance.Settings.Actions.Title}">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Text="{DynamicResource Bedrock.Instance.Settings.Delete.Hint}" FontSize="11.5"
                               Opacity="0.6" TextWrapping="Wrap" />
                    <local:SymbioButton x:Name="BtnGotoActions" Margin="0,14,0,0" MinWidth="140" Height="35"
                                    Padding="13,0" HorizontalAlignment="Left"
                                    Text="{DynamicResource Bedrock.Instance.Left.Actions}" />
                </StackPanel>
            </local:WorkspaceCard>

        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

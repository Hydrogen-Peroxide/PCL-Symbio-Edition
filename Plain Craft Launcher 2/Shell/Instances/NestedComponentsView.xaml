<local:WorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.NestedComponentsView"
    PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="{StaticResource SePageScrollMargin}">
                <local:WorkspaceCard Margin="0,15,0,15" x:Name="PanManage">
                    <WrapPanel Margin="15,8,0,15">
                        <local:SymbioButton x:Name="BtnBack" MinWidth="110"
                                        Text="{DynamicResource Instance.Resource.BackToParent}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                        <local:SymbioButton x:Name="BtnRefresh" MinWidth="110"
                                        Text="{DynamicResource Common.Action.Refresh}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" />
                        <TextBlock VerticalAlignment="Center" Margin="0,7,15,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SyAccentText}"
                                   Text="{DynamicResource Instance.Resource.Mod.JarInJar.Message}" />
                    </WrapPanel>
                </local:WorkspaceCard>

                <local:SymbioSearchField Margin="0,0,0,15" x:Name="SearchBox"
                                   HintText="{DynamicResource Instance.Resource.Mod.JarInJar.Search.Hint}" />

                <local:WorkspaceCard x:Name="CardWarnings" Margin="0,0,0,15">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Warnings}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SyAccentText}" />
                        <StackPanel x:Name="PanWarnList" Margin="0,8,0,0" />
                    </StackPanel>
                </local:WorkspaceCard>

                <local:WorkspaceCard x:Name="CardConflicts" Margin="0,0,0,15">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Conflicts}"
                                   ToolTip="{DynamicResource Instance.Resource.Mod.JarInJar.Conflict.Tooltip}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SyAccentText}" />
                        <StackPanel x:Name="PanConflictList" Margin="0,8,0,0" />
                    </StackPanel>
                </local:WorkspaceCard>

                <StackPanel x:Name="SectionRelations">
                    <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Relations}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SyAccentText}"
                               Margin="2,0,0,8" />
                    <StackPanel x:Name="PanRelationList" />
                </StackPanel>

                <StackPanel x:Name="SectionBundled">
                    <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Bundled}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SyAccentText}"
                               Margin="2,4,0,8" />
                    <StackPanel x:Name="PanBundledList" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <local:WorkspaceCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty"
                      Visibility="Collapsed">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center"
                           Text="{DynamicResource Instance.Resource.Mod.JarInJar.Empty.Title}" FontSize="19"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource SyAccentText}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource SyAccentText}" />
                <TextBlock Margin="10,10,10,0" Text="{DynamicResource Instance.Resource.Mod.JarInJar.Empty.Message}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                <local:SymbioButton Height="35" x:Name="BtnEmptyBack" MinWidth="130"
                                Text="{DynamicResource Instance.Resource.BackToParent}" Margin="5,20,5,5"
                                Padding="12,0" HorizontalAlignment="Center" ColorType="Highlight" />
            </StackPanel>
        </local:WorkspaceCard>
        <local:WorkspaceCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False">
            <local:LoadingIndicator Text="{DynamicResource Instance.Resource.Loading}" Margin="20,20,20,17" x:Name="Load"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </local:WorkspaceCard>
    </Grid>
</local:WorkspacePage>

<local:WorkspacePage x:Class="PCL.FeedbackSettingsView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Style="{StaticResource SySettingsPage}">
            <TextBlock Style="{StaticResource SyPageTitle}" Text="{DynamicResource Setup.Left.Item.Feedback}" />
            <local:SettingsCard x:Name="PanInfo" Icon="lucide/message-circle" Header="{DynamicResource Setup.Feedback.Submit.Title}"
                                Description="{DynamicResource Setup.Feedback.Submit.Description}">
                <local:SymbioButton x:Name="BtnManageOpen" MinWidth="120" MinHeight="32" Text="{DynamicResource Setup.Feedback.Submit.Open}"
                                    Padding="13,0" ColorType="Highlight" Click="Feedback_Click" />
            </local:SettingsCard>
            <StackPanel x:Name="PanContent" Margin="0,20,0,0">
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Processing}" Margin="0,0,0,8" x:Name="PanContentProcessing" CanSwap="True">
                    <StackPanel x:Name="PanListProcessing" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.WaitingProcess}" Margin="0,0,0,8" x:Name="PanContentWaitingProcess" CanSwap="True">
                    <StackPanel x:Name="PanListWaitingProcess" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Waiting}" Margin="0,0,0,8" x:Name="PanContentWait" CanSwap="True">
                    <StackPanel x:Name="PanListWait" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Paused}" Margin="0,0,0,8" x:Name="PanContentPause" CanSwap="True">
                    <StackPanel x:Name="PanListPause" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.UpNext}" Margin="0,0,0,8" x:Name="PanContentUpnext" CanSwap="True">
                    <StackPanel x:Name="PanListUpnext" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Completed}" Margin="0,0,0,8" x:Name="PanContentCompleted" CanSwap="True"
                              IsSwapped="True">
                    <StackPanel x:Name="PanListCompleted" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Declined}" Margin="0,0,0,8" x:Name="PanContentDecline" CanSwap="True" IsSwapped="True">
                    <StackPanel x:Name="PanListDecline" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Ignored}" Margin="0,0,0,8" x:Name="PanContentIgnored" CanSwap="True" IsSwapped="True">
                    <StackPanel x:Name="PanListIgnored" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
                <local:WorkspaceCard Title="{DynamicResource Setup.Feedback.Status.Duplicate}" Margin="0,0,0,8" x:Name="PanContentDuplicate" CanSwap="True" IsSwapped="True">
                    <StackPanel x:Name="PanListDuplicate" Orientation="Vertical" Margin="20,36,18,18" />
                </local:WorkspaceCard>
            </StackPanel>
            <local:WorkspaceCard HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"
                          x:Name="PanLoad" UseAnimation="False" Margin="40,50">
                <local:LoadingIndicator Text="{DynamicResource Setup.Feedback.Loading}" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
            </local:WorkspaceCard>
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

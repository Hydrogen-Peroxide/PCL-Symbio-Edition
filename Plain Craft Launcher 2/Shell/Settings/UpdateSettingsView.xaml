<local:WorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:glass="clr-namespace:PCLLF.Wpf.Glass" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.UpdateSettingsView"
    PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Style="{StaticResource SySettingsPage}">
            <TextBlock Style="{StaticResource SyPageTitle}" Text="{DynamicResource Setup.Left.Item.Update}" />

            <!-- Status hero (Windows Update style): an update is available -->
            <glass:GlassSurface x:Name="CardUpdate" Style="{StaticResource SyFrostPanel}" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:AssetImage x:Name="ImgUpdateIcon" Address="pack://application:,,,/Images/icon.png"
                                          Height="56" Width="56" Margin="0,0,20,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TextUpdateName" Text="PCL SE 2.14.0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SyText}" />
                            <TextBlock x:Name="TextUpdateDesc" Text="by PCL Symbio" Margin="0,2,0,0" Foreground="{DynamicResource SyTextSecondary}" />
                        </StackPanel>
                        <local:SymbioButton Grid.Column="2" x:Name="BtnUpdate" Text="{DynamicResource Setup.Update.Install}" ColorType="Highlight"
                                            MinWidth="120" Height="32" Padding="16,0" VerticalAlignment="Center" Click="BtnUpdate_Click" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource SyDivider}" Margin="0,18,0,14" />
                    <TextBlock x:Name="TextChangelog" Text="{DynamicResource Setup.Update.Changelog.Placeholder}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SyTextSecondary}" LineHeight="20" />
                    <local:SymbioButton IsTextAction="True" x:Name="BtnChangelogDetail" Text="{DynamicResource Setup.Update.Changelog.MoreInfo}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Click="BtnChangelogDetail_Click" />
                </StackPanel>
            </glass:GlassSurface>

            <!-- Status hero: up to date / check result -->
            <glass:GlassSurface x:Name="CardCheck" Style="{StaticResource SyFrostPanel}" Padding="24,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Images/icon.png" Height="56" Width="56" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TextCurrentDesc" Text="{DynamicResource Setup.Update.Latest}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SyText}" />
                        <TextBlock x:Name="TextCurrentVersion" Text="PCL SE 2.13.4" Margin="0,2,0,0" Foreground="{DynamicResource SyTextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <local:SymbioButton x:Name="BtnChangelog" Text="{DynamicResource Setup.Update.Changelog.View}" MinWidth="100" Height="32"
                                            Padding="14,0" Margin="0,0,8,0" Click="BtnChangelog_Click" />
                        <local:SymbioButton x:Name="BtnCheckAgain" Text="{DynamicResource Setup.Update.CheckAgain}" ColorType="Highlight" MinWidth="120"
                                            Height="32" Padding="16,0" Click="BtnCheckAgain_OnClick" />
                    </StackPanel>
                </Grid>
            </glass:GlassSurface>

            <!-- Update options -->
            <TextBlock Style="{StaticResource SySectionHeader}" Margin="1,24,0,8" Text="{DynamicResource Setup.Update.Options.Title}" />
            <local:SettingsCard Icon="lucide/git-pull-request-arrow" Header="{DynamicResource Setup.Update.Channel.Title}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboSystemUpdateChannel" Tag="SystemUpdateChannel"
                                    SelectionChanged="ComboSystemUpdateBranch_SelectionChanged">
                    <local:SelectOption Content="{DynamicResource Setup.Update.Channel.Release}"
                                        ToolTip="{DynamicResource Setup.Update.Channel.Release.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Channel.Beta}"
                                        ToolTip="{DynamicResource Setup.Update.Channel.Beta.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Channel.Dev}"
                                        ToolTip="{DynamicResource Setup.Update.Channel.Dev.ToolTip}" Visibility="Collapsed" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/download" Header="{DynamicResource Setup.Update.Auto.Title}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboSystemUpdateMode" Tag="SystemUpdateMode"
                                    SelectionChanged="ComboSystemUpdateMode_SelectionChanged">
                    <local:SelectOption Content="{DynamicResource Setup.Update.Auto.DownloadAndInstall}" ToolTip="{DynamicResource Setup.Update.Auto.DownloadAndInstall.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Auto.DownloadAndNotify}" ToolTip="{DynamicResource Setup.Update.Auto.DownloadAndNotify.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Auto.NotifyOnly}" ToolTip="{DynamicResource Setup.Update.Auto.NotifyOnly.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Auto.Disabled}" ToolTip="{DynamicResource Setup.Update.Auto.Disabled.ToolTip}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/server" Header="{DynamicResource Setup.Update.Source.Title}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboUpdateSource" Tag="UpdateSource" SelectionChanged="ComboUpdateSource_SelectionChanged">
                    <local:SelectOption Content="{DynamicResource Setup.Update.Source.CnbFirst}" ToolTip="{DynamicResource Setup.Update.Source.CnbFirst.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Source.GitHubFirst}" ToolTip="{DynamicResource Setup.Update.Source.GitHubFirst.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Source.CnbOnly}" ToolTip="{DynamicResource Setup.Update.Source.CnbOnly.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Update.Source.GitHubOnly}" ToolTip="{DynamicResource Setup.Update.Source.GitHubOnly.ToolTip}" />
                </local:SymbioSelect>
            </local:SettingsCard>

            <!-- Optional product upgrade (currently unused, kept hidden) -->
            <local:SettingsExpander x:Name="CardOtherOption" Icon="lucide/package-plus" Header="{DynamicResource Setup.Update.OtherOptions.Title}"
                                    Margin="0,20,0,0" Visibility="Collapsed">
                <local:SettingsRow Stacked="True" Padding="58,12,16,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="TextOptionalUpdateName" Text="AquaCL 3.0.0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SyText}" />
                                <TextBlock x:Name="TextOptionalUpdateDesc" Text="20.0 MiB" Foreground="{DynamicResource SyTextSecondary}" />
                            </StackPanel>
                            <local:SymbioButton x:Name="BtnOptionalUpdate" Text="{DynamicResource Setup.Update.Install}" ColorType="Highlight"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="100" Height="32" Padding="14,0" />
                        </Grid>
                        <TextBlock x:Name="TextOptionalChangelog" Text="{DynamicResource Setup.Update.OtherOptions.Placeholder}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Foreground="{DynamicResource SyTextSecondary}" />
                        <local:SymbioButton IsTextAction="True" x:Name="BtnOptionalChangelogDetail" Text="{DynamicResource Setup.Update.Changelog.MoreInfo}"
                                            Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </local:SettingsRow>
            </local:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

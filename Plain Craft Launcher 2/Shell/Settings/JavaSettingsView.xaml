<local:WorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:glass="clr-namespace:PCLLF.Wpf.Glass" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.JavaSettingsView"
    PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid>
            <StackPanel x:Name="PanMain" Style="{StaticResource SySettingsPage}">
                <!-- Page header: title with the primary command on the right -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource SyPageTitle}" Margin="0" Text="{DynamicResource Setup.Left.Item.Java}" />
                    <local:SymbioIconTextAction x:Name="BtnAdd" Text="{DynamicResource Setup.Java.Add}" LogoScale="0.9" Click="BtnAdd_Click"
                                                SvgIcon="lucide/circle-plus" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <glass:GlassSurface Style="{StaticResource SyFrostPanel}">
                    <StackPanel Margin="4" Orientation="Vertical" x:Name="PanContent" />
                </glass:GlassSurface>
            </StackPanel>
            <local:WorkspaceCard x:Name="CardLoad" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:LoadingIndicator Text="{DynamicResource Setup.Java.Loading}" x:Name="PanLoad" Margin="12" />
            </local:WorkspaceCard>
        </Grid>
    </ScrollViewer>
</local:WorkspacePage>

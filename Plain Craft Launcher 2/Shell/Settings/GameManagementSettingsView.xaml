<local:WorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.GameManagementSettingsView"
    PanScroll="{Binding ElementName=PanBack}">
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Style="{StaticResource SySettingsPage}">
            <TextBlock Style="{StaticResource SyPageTitle}" Text="{DynamicResource Setup.Left.Item.GameManage}" />

            <!-- Download sources and behaviour -->
            <TextBlock Style="{StaticResource SySectionHeader}" Margin="1,0,0,8" Text="{DynamicResource Setup.GameManage.Source.Title}" />
            <local:SettingsCard Icon="lucide/download" Header="{DynamicResource Setup.GameManage.Source.File}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboDownloadSource" Tag="ToolDownloadSource" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.UseMirror}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.PreferOfficialThenMirror}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.UseOfficial}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/layout-list" Header="{DynamicResource Setup.GameManage.Source.Version}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboDownloadVersion" Tag="ToolDownloadVersion" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.Version.Mirror}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.PreferOfficialThenMirror}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.UseOfficial}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/gauge" Header="{DynamicResource Setup.GameManage.Download.Threads}"
                                Description="{DynamicResource Setup.GameManage.Download.Threads.ToolTip}" ActionWidth="260">
                <local:SymbioSlider x:Name="SliderDownloadThread" Tag="ToolDownloadThread"
                                    PreviewChange="SliderDownloadThread_PreviewChange"
                                    MaxValue="255" Value="63" Change="SliderChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/move-down" Header="{DynamicResource Setup.GameManage.Download.SpeedLimit}"
                                Description="{DynamicResource Setup.GameManage.Download.SpeedLimit.ToolTip}" ActionWidth="260">
                <local:SymbioSlider x:Name="SliderDownloadSpeed" Tag="ToolDownloadSpeed" MaxValue="42" Value="42" Change="SliderChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/folder-open" Header="{DynamicResource Setup.GameManage.Download.TargetFolder}"
                                Description="{DynamicResource Setup.GameManage.Download.TargetFolder.Hint}" />
            <local:SettingsCard Icon="lucide/layers" Header="{DynamicResource Setup.GameManage.Download.AutoSelectInstance}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckDownloadAutoSelectVersion"
                                   Tag="ToolDownloadAutoSelectVersion" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/shield-check" Header="{DynamicResource Setup.GameManage.Download.FixAuthlib}"
                                Description="{DynamicResource Setup.GameManage.Download.FixAuthlib.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckFixAuthlib" Tag="ToolFixAuthlib" Change="CheckBoxChange" />
            </local:SettingsCard>

            <!-- Community resources -->
            <TextBlock Style="{StaticResource SySectionHeader}" Text="{DynamicResource Setup.GameManage.Community.Title}" />
            <local:SettingsCard Icon="lucide/globe" Header="{DynamicResource Setup.GameManage.Community.Source}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboDownloadMod" Tag="ToolDownloadMod" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.UseMirror}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.Source.PreferOfficialWithFallback}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Source.UseOfficial}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard x:Name="TextFilenameFormat" Icon="lucide/file-box" Header="{DynamicResource Setup.GameManage.Community.FilenameFormat}"
                                Description="{DynamicResource Setup.GameManage.Community.FilenameFormat.ToolTip}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboDownloadTranslateV2" Tag="ToolDownloadTranslateV2" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.FilenameFormat.Style0}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.FilenameFormat.Style1}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.FilenameFormat.Style2}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.FilenameFormat.Style3}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.FilenameFormat.Style4}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard x:Name="TextModManageStyle" Icon="lucide/puzzle" Header="{DynamicResource Setup.GameManage.Community.ModManageStyle}"
                                Description="{DynamicResource Setup.GameManage.Community.ModManageStyle.ToolTip}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboModLocalNameStyle" Tag="ToolModLocalNameStyle" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.ModManageStyle.TitleTranslation}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.ModManageStyle.TitleFilename}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/rocket" Header="{DynamicResource Setup.GameManage.Community.QuickDownload}"
                                Description="{DynamicResource Setup.GameManage.Community.QuickDownload.ToolTip}" ActionWidth="260">
                <local:SymbioSelect x:Name="ComboDownloadQuickBehavior" Tag="ToolDownloadQuickBehavior" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.QuickDownload.AlwaysAsk}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.QuickDownload.CurrentInstance}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.QuickDownload.AskInstance}" />
                    <local:SelectOption Content="{DynamicResource Setup.GameManage.Community.QuickDownload.AskPath}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/list-x" Header="{DynamicResource Setup.GameManage.Community.HideQuilt}"
                                Description="{DynamicResource Setup.GameManage.Community.HideQuilt.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckDownloadIgnoreQuilt" Tag="ToolDownloadIgnoreQuilt" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/boxes" Header="{DynamicResource Setup.GameManage.Community.AutoInstallDependencies}"
                                Description="{DynamicResource Setup.GameManage.Community.AutoInstallDependencies.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckDownloadAutoInstallDependencies"
                                   Tag="ToolDownloadAutoInstallDependencies" Change="CheckBoxChange" />
            </local:SettingsCard>

            <!-- Accessibility -->
            <TextBlock Style="{StaticResource SySectionHeader}" Text="{DynamicResource Setup.GameManage.Accessibility.Title}" />
            <local:SettingsExpander Icon="lucide/sparkles" Header="{DynamicResource Setup.GameManage.Accessibility.GameUpdateNotice}" IsExpanded="True">
                <local:SettingsRow Header="{DynamicResource Setup.GameManage.Accessibility.ReleaseNotice}"
                                   Description="{DynamicResource Setup.GameManage.Accessibility.ReleaseNotice.ToolTip}">
                    <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckUpdateRelease" Tag="ToolUpdateRelease" Change="CheckBoxChange" />
                </local:SettingsRow>
                <local:SettingsRow Header="{DynamicResource Setup.GameManage.Accessibility.SnapshotNotice}"
                                   Description="{DynamicResource Setup.GameManage.Accessibility.SnapshotNotice.ToolTip}">
                    <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckUpdateSnapshot" Tag="ToolUpdateSnapshot" Change="CheckBoxChange" />
                </local:SettingsRow>
            </local:SettingsExpander>
            <local:SettingsCard Icon="lucide/earth" Header="{DynamicResource Setup.GameManage.Accessibility.GameLanguage}"
                                Description="{DynamicResource Setup.GameManage.Accessibility.AutoLauncherLanguage}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckHelpLauncherLanguage" Tag="ToolHelpChinese" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/copy" Header="{DynamicResource Setup.GameManage.Accessibility.ReadClipboard}"
                                Description="{DynamicResource Setup.GameManage.Accessibility.ReadClipboard.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckDownloadClipboard" Tag="ToolDownloadClipboard" Change="CheckBoxChange" />
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

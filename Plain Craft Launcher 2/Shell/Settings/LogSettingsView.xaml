<local:WorkspacePage x:Class="PCL.LogSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:glass="clr-namespace:PCLLF.Wpf.Glass" xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
    PanScroll="{Binding ElementName=Scroll}">
    <ScrollViewer x:Name="Scroll" Style="{StaticResource SyScrollViewer}" local:ScrollInput.Enabled="True"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SySettingsPage}">
            <TextBlock Style="{StaticResource SyPageTitle}" Text="{DynamicResource Setup.Left.Item.Log}" />
            <!-- Command bar -->
            <WrapPanel Margin="0,0,0,12">
                <Button Style="{StaticResource SyAccentButton}" Margin="0,0,8,8" Click="OpenDirectory" Content="{DynamicResource Setup.Log.OpenDirectory}" />
                <Button Style="{StaticResource SyButton}" Margin="0,0,8,8" Click="ExportCurrent" Content="{DynamicResource Setup.Log.Export}" />
                <Button Style="{StaticResource SyButton}" Margin="0,0,8,8" Click="ExportAll" Content="{DynamicResource Setup.Log.ExportAll}" />
                <Button Style="{StaticResource SyButton}" Margin="0,0,8,8" Click="Clean" Content="{DynamicResource Setup.Log.ClearHistory}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource SySectionHeader}" Margin="1,0,0,8" Text="{DynamicResource Setup.Log.AllLogs}" />
            <glass:GlassSurface Style="{StaticResource SyFrostPanel}">
                <ItemsControl x:Name="Files">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <!-- List row: file icon, title and path; the whole row opens the log -->
                        <Button Click="OpenFile" Style="{StaticResource SySubtleButton}" HorizontalContentAlignment="Stretch"
                                Padding="12,8" Margin="0,0,0,2" ToolTip="{Binding Path}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <svgIcon:SvgIcon Icon="lucide/scroll-text" Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center"
                                                      IconBrush="{DynamicResource SyTextSecondary}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource SyText}" />
                                    <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource SyTextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <svgIcon:SvgIcon Grid.Column="2" Icon="lucide/chevron-right" Width="14" Height="14" Margin="12,0,0,0"
                                                      VerticalAlignment="Center" IconBrush="{DynamicResource SyTextTertiary}" />
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </glass:GlassSurface>
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

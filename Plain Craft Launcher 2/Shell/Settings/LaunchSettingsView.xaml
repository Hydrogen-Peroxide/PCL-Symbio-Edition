<local:WorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:val="https://ce.pclc.cc/core/utils/validate"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PCL.LaunchSettingsView"
    PanScroll="{Binding ElementName=PanBack, Mode=OneWay}">
    <!-- Fluent settings page: page title, sections, one SettingsCard per setting -->
    <ScrollViewer local:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Style="{StaticResource SySettingsPage}" Grid.IsSharedSizeScope="True">
            <TextBlock Style="{StaticResource SyPageTitle}" Text="{DynamicResource Setup.Left.Item.Launch}" />

            <!-- Launch options -->
            <TextBlock Style="{StaticResource SySectionHeader}" Margin="1,0,0,8" Text="{DynamicResource Setup.Launch.Options.Title}" />
            <local:SettingsCard Icon="lucide/layers" Header="{DynamicResource Setup.Launch.Options.InstanceIsolation.Label}"
                                Description="{DynamicResource Setup.Launch.Options.InstanceIsolation.ToolTip}" ActionWidth="240">
                <local:SymbioSelect x:Name="ComboArgumentIndieV2" Tag="LaunchArgumentIndieV2"
                                    SelectionChanged="ComboArgumentIndie_OnSelectionChanged">
                    <local:SelectOption Content="{DynamicResource Common.Action.Close}"
                                        ToolTip="{DynamicResource Setup.Launch.Options.InstanceIsolation.None.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.InstanceIsolation.ModdedOnly}" IsSelected="True"
                                        ToolTip="{DynamicResource Setup.Launch.Options.InstanceIsolation.ModdedOnly.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.InstanceIsolation.NonRelease}" ToolTip="{DynamicResource Setup.Launch.Options.InstanceIsolation.NonRelease.ToolTip}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.InstanceIsolation.ModdedAndNonRelease}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.InstanceIsolation.All}"
                                        ToolTip="{DynamicResource Setup.Launch.Options.InstanceIsolation.All.ToolTip}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/monitor" Header="{DynamicResource Setup.Launch.Options.WindowTitle.Label}"
                                Description="{DynamicResource Setup.Launch.Options.WindowTitle.ToolTip}" ActionWidth="240">
                <local:SymbioSelect x:Name="TextArgumentTitle" Tag="LaunchArgumentTitle" IsEditable="True"
                                    IsTextSearchEnabled="False" TextChanged="TextArgumentTitle_OnTextChanged"
                                    HintText="{DynamicResource Common.Option.Default}">
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.WindowTitle.SampleFormat}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/pencil" Header="{DynamicResource Setup.Launch.Options.CustomInfo.Label}"
                                Description="{DynamicResource Setup.Launch.Options.CustomInfo.ToolTip}" ActionWidth="240">
                <local:SymbioTextField x:Name="TextArgumentInfo" Tag="LaunchArgumentInfo" Text="PCL"
                                       ValidatedTextChanged="TextBoxChange">
                    <local:SymbioTextField.ValidateRules>
                        <val:BlacklistValidator>
                            <val:BlacklistValidator.Blacklist>
                                <System:String>"</System:String>
                                <System:String>“</System:String>
                                <System:String>”</System:String>
                            </val:BlacklistValidator.Blacklist>
                        </val:BlacklistValidator>
                    </local:SymbioTextField.ValidateRules>
                </local:SymbioTextField>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/monitor-cog" Header="{DynamicResource Setup.Launch.Options.Visibility.Label}" ActionWidth="240">
                <local:SymbioSelect x:Name="ComboArgumentVisibie" Tag="LaunchArgumentVisible"
                                    SelectionChanged="ComboArgumentVisibie_SelectionChanged">
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Visibility.CloseImmediately}" />
                    <local:SelectOption Content="" IsEnabled="False" Visibility="Collapsed" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Visibility.HideAndCloseOnExit}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Visibility.HideAndReopenOnExit}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Visibility.Minimize}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Visibility.KeepUnchanged}" IsSelected="True" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/gauge" Header="{DynamicResource Setup.Launch.Options.Priority.Label}" ActionWidth="240">
                <local:SymbioSelect x:Name="ComboArgumentPriority" Tag="LaunchArgumentPriority"
                                    SelectionChanged="ComboChange" SelectedValuePath="Tag">
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Priority.RealTime}" Tag="4" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Priority.High}" Tag="3" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Priority.AboveNormal}" Tag="0" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Priority.Normal}" IsSelected="True" Tag="1" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.Priority.BelowNormal}" Tag="2" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/layout-dashboard" Header="{DynamicResource Setup.Launch.Options.WindowSize.Label}"
                                Description="{DynamicResource Setup.Launch.Options.WindowSize.ModernUiWarning}">
                <StackPanel x:Name="PanArgumentWindow" Orientation="Horizontal">
                    <local:SymbioTextField Visibility="Collapsed" Margin="0,0,0,0"
                                           x:Name="TextArgumentWindowWidth" Tag="LaunchArgumentWindowWidth"
                                           Width="64" HorizontalContentAlignment="Center" Text="854"
                                           ValidatedTextChanged="TextBoxChange">
                        <local:SymbioTextField.ValidateRules>
                            <val:IntValidator Min="1" Max="9999" />
                        </local:SymbioTextField.ValidateRules>
                    </local:SymbioTextField>
                    <TextBlock x:Name="LabArgumentWindowMiddle" Visibility="Collapsed"
                               Text=" × " VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource SyTextSecondary}" />
                    <local:SymbioTextField Visibility="Collapsed" Width="64" Margin="0,0,12,0"
                                           HorizontalContentAlignment="Center" x:Name="TextArgumentWindowHeight"
                                           Tag="LaunchArgumentWindowHeight" Text="480"
                                           ValidatedTextChanged="TextBoxChange"
                                           ToolTip="{DynamicResource Setup.Launch.Options.WindowSize.CustomHeightBug.ToolTip}">
                        <local:SymbioTextField.ValidateRules>
                            <val:IntValidator Min="1" Max="9999" />
                        </local:SymbioTextField.ValidateRules>
                    </local:SymbioTextField>
                    <local:SymbioSelect x:Name="ComboArgumentWindowType" Tag="LaunchArgumentWindowType" Width="200"
                                        SelectionChanged="ComboChange">
                        <local:SelectOption Content="{DynamicResource Setup.Launch.Options.WindowSize.Fullscreen}" />
                        <local:SelectOption Content="{DynamicResource Common.Option.Default}" IsSelected="True" />
                        <local:SelectOption Content="{DynamicResource Setup.Launch.Options.WindowSize.SameAsLauncher}" />
                        <local:SelectOption Content="{DynamicResource Setup.Launch.Options.WindowSize.Custom}" ToolTip="{DynamicResource Setup.Launch.Options.WindowSize.CustomHeightBug.ToolTip}" />
                        <local:SelectOption Content="{DynamicResource Setup.Launch.Options.WindowSize.Maximized}" />
                    </local:SymbioSelect>
                </StackPanel>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/shield-check" Header="{DynamicResource Setup.Launch.Options.MsAuth.Label}"
                                Description="{DynamicResource Setup.Launch.Options.MsAuth.ToolTip}" ActionWidth="240">
                <local:SymbioSelect x:Name="ComboMsAuthType" Tag="LoginMsAuthType" SelectionChanged="ComboChange" IsEnabled="False">
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.MsAuth.WebManager}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.MsAuth.DeviceCode}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/network" Header="{DynamicResource Setup.Launch.Options.IpStack.Label}"
                                Description="{DynamicResource Setup.Launch.Options.IpStack.ToolTip}" ActionWidth="240">
                <local:SymbioSelect x:Name="ComboPreferredIpStack" Tag="LaunchPreferredIpStack" SelectionChanged="ComboChange">
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.IpStack.Ipv4}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.IpStack.JavaDefault}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Options.IpStack.Ipv6}" />
                </local:SymbioSelect>
            </local:SettingsCard>

            <!-- Memory -->
            <TextBlock Style="{StaticResource SySectionHeader}" Text="{DynamicResource Setup.Launch.Memory.Title}" />
            <local:SymbioNotice x:Name="LabRamWarn" Visibility="Visible" Margin="0,0,0,4"
                                Text="{DynamicResource Setup.Launch.Memory.Warning.Java32Bit}" Theme="Yellow" />
            <local:SymbioNotice x:Name="HintRamTooHigh" Visibility="Collapsed" Theme="Yellow" Margin="0,0,0,4"
                                Text="{DynamicResource Setup.Launch.Memory.Warning.TooMuch}" HorizontalAlignment="Stretch" />
            <local:SettingsCard Icon="lucide/memory-stick" Header="{DynamicResource Setup.Launch.Memory.Auto}"
                                Description="{DynamicResource Setup.Launch.Memory.Auto.ToolTip}">
                <StackPanel Orientation="Horizontal">
                    <local:SymbioRadio Text="{DynamicResource Setup.Launch.Memory.Auto}" IsChecked="True" x:Name="RadioRamType0"
                                       Tag="LaunchRamType/0" Margin="0,0,20,0" Check="RadioBoxChange" />
                    <local:SymbioRadio Text="{DynamicResource Common.Option.Customize}" x:Name="RadioRamType1" Tag="LaunchRamType/1"
                                       Check="RadioBoxChange" />
                </StackPanel>
            </local:SettingsCard>
            <local:SettingsCard Stacked="True" Header="{DynamicResource Setup.Launch.Memory.GameAllocation}" Padding="58,12,16,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RamLabel" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Setup.Launch.Memory.Max}" VerticalAlignment="Center" Margin="0,0,20,10"
                                   Foreground="{DynamicResource SyTextSecondary}" ToolTip="{DynamicResource Setup.Launch.Memory.Max.ToolTip}" />
                        <local:SymbioSlider Grid.Column="1" IsEnabled="False" x:Name="SliderRamCustom"
                                            Tag="LaunchRamCustom" MaxValue="49" Value="13" Change="SliderChange" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource Setup.Launch.Memory.Initial}" VerticalAlignment="Center" Margin="0,0,20,0"
                                   Foreground="{DynamicResource SyTextSecondary}" ToolTip="{DynamicResource Setup.Launch.Memory.Initial.ToolTip}" />
                        <local:SymbioSlider Grid.Row="1" Grid.Column="1" IsEnabled="False" x:Name="SliderRamInitialCustom"
                                            Tag="LaunchRamCustomInitial" MaxValue="49" Value="0" Change="SliderChange"
                                            ToolTip="{DynamicResource Setup.Launch.Memory.Initial.ToolTip}" />
                    </Grid>
                    <!-- Memory meter: system used / game allocation / free -->
                    <Grid x:Name="PanRamDisplay" Margin="0,10,2,0" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnRamUsed" Width="4.7*" />
                            <ColumnDefinition x:Name="ColumnRamGame" Width="2.5*" />
                            <ColumnDefinition x:Name="ColumnRamEmpty" Width="0.7*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="6" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" CornerRadius="3" ClipToBounds="True" />
                        <Rectangle x:Name="RectRamUsed" Grid.Row="1" StrokeThickness="0" RadiusX="3" RadiusY="3"
                                   Fill="{DynamicResource SyControlStrongStroke}" />
                        <Rectangle Grid.Row="1" StrokeThickness="0" Grid.Column="1" Margin="2,0,0,0" RadiusX="3" RadiusY="3"
                                   Fill="{DynamicResource SyAccentFill}" x:Name="RectRamGame" />
                        <Rectangle x:Name="RectRamEmpty" Grid.Row="1" StrokeThickness="0" Grid.Column="2" Margin="2,0,0,0" RadiusX="3" RadiusY="3"
                                   Fill="{DynamicResource SyControlStroke}" />
                        <TextBlock x:Name="LabRamUsedTitle" Text="{DynamicResource Setup.Launch.Memory.UsedTotal}" Grid.ColumnSpan="3"
                                   Foreground="{DynamicResource SyTextSecondary}"
                                   TextTrimming="None" Margin="2,0,0,6" FontSize="12" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabRamGameTitle" Text="{DynamicResource Setup.Launch.Memory.GameAllocation}" Grid.ColumnSpan="3"
                                   Foreground="{DynamicResource SyTextSecondary}"
                                   TextTrimming="None" Margin="2,0,0,6" FontSize="12" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.ColumnSpan="3" Margin="2,6,0,0"
                                    HorizontalAlignment="Left">
                            <TextBlock x:Name="LabRamUsed" Text="4.7 GiB" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SyText}" TextTrimming="None" />
                            <TextBlock x:Name="LabRamTotal" Text=" / 7.9 GiB" FontSize="14"
                                       Foreground="{DynamicResource SyTextSecondary}" TextTrimming="None" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="LabRamGame" Text="2.5 GiB" Grid.ColumnSpan="3"
                                   TextTrimming="None" Margin="2,6,0,0" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SyAccentText}" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </local:SettingsCard>

            <!-- Advanced: collapsed by default, like the former swapped card -->
            <TextBlock Style="{StaticResource SySectionHeader}" Text="{DynamicResource Setup.Launch.Advanced.Title}" />
            <local:SettingsCard Icon="lucide/monitor-cog" Header="{DynamicResource Setup.Launch.Advanced.Renderer.Label}" ActionWidth="240">
                <local:SymbioSelect x:Name="ComboAdvanceRenderer" Tag="LaunchAdvanceRenderer"
                                    SelectionChanged="ComboAdvanceRenderer_OnSelectionChanged">
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Advanced.Renderer.GameDefault}" IsSelected="True" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Advanced.Renderer.Software}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Advanced.Renderer.DirectX12}" />
                    <local:SelectOption Content="{DynamicResource Setup.Launch.Advanced.Renderer.Vulkan}" />
                </local:SymbioSelect>
            </local:SettingsCard>
            <local:SettingsExpander Icon="lucide/scroll-text" Header="{DynamicResource Setup.Launch.Advanced.JvmHead}"
                                    Description="{DynamicResource Setup.Launch.Advanced.JvmHead.ToolTip}">
                <local:SettingsExpander.HeaderAction>
                    <local:SymbioIconButton Height="30" Width="30" x:Name="BtnAdvanceJvmReset" Margin="0,0,4,0"
                                            Click="BtnAdvanceJvmReset_Click"
                                            ToolTip="{DynamicResource Setup.Launch.Advanced.JvmHead.Restore}"
                                            SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                </local:SettingsExpander.HeaderAction>
                <local:SettingsRow Stacked="True" Padding="58,12,16,14">
                    <local:SymbioTextField x:Name="TextAdvanceJvm" Tag="LaunchAdvanceJvm"
                                           TextChanged="TextAdvanceJvm_TextChanged" ValidatedTextChanged="TextBoxChange"
                                           MaxLength="4000" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                           VerticalContentAlignment="Top" Padding="10,6" VerticalScrollBarVisibility="Auto" />
                </local:SettingsRow>
            </local:SettingsExpander>
            <local:SettingsCard Icon="lucide/file-input" Header="{DynamicResource Setup.Launch.Advanced.GameTail}"
                                Description="{DynamicResource Setup.Launch.Advanced.GameTail.ToolTip}" ActionWidth="300">
                <local:SymbioTextField x:Name="TextAdvanceGame" Tag="LaunchAdvanceGame" ValidatedTextChanged="TextBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/play" Header="{DynamicResource Setup.Launch.Advanced.PreLaunchCommand}"
                                Description="{DynamicResource Setup.Launch.Advanced.PreLaunchCommand.ToolTip}" ActionWidth="300">
                <StackPanel>
                    <local:SymbioTextField x:Name="TextAdvanceRun" Tag="LaunchAdvanceRun" HintText=""
                                           ValidatedTextChanged="TextBoxChange" TextChanged="TextAdvanceRun_TextChanged" />
                    <local:SymbioCheck x:Name="CheckAdvanceRunWait" Tag="LaunchAdvanceRunWait" Visibility="Collapsed"
                                       Change="CheckBoxChange" Margin="0,8,0,0"
                                       Text="{DynamicResource Setup.Launch.Advanced.PreLaunchCommand.Wait}" />
                </StackPanel>
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/flask-conical" Header="{DynamicResource Setup.Launch.Advanced.DisableJlw}"
                                Description="{DynamicResource Setup.Launch.Advanced.DisableJlw.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceDisableJLW" Tag="LaunchAdvanceDisableJLW" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/flask-conical" Header="{DynamicResource Setup.Launch.Advanced.DisableLF}"
                                Description="{DynamicResource Setup.Launch.Advanced.DisableLF.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceDisableLF" Tag="LaunchAdvanceDisableLF" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/cpu" Header="{DynamicResource Setup.Launch.Advanced.GpuPreference}"
                                Description="{DynamicResource Setup.Launch.Advanced.GpuPreference.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceGraphicCard" Tag="LaunchAdvanceGraphicCard" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/coffee" Header="{DynamicResource Setup.Launch.Advanced.UseJavaExe}"
                                Description="{DynamicResource Setup.Launch.Advanced.UseJavaExe.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceNoJavaw" Tag="LaunchAdvanceNoJavaw" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/circuit-board" Header="{DynamicResource Setup.Launch.Advanced.DisableLwjglUnsafeAgent}"
                                Description="{DynamicResource Setup.Launch.Advanced.DisableLwjglUnsafeAgent.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceDisableLwjglUnsafeAgent" Tag="LaunchAdvanceDisableLwjglUnsafeAgent" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/triangle-alert" Header="{DynamicResource Setup.Launch.Advanced.DisableCrashAnalysis}"
                                Description="{DynamicResource Setup.Launch.Advanced.DisableCrashAnalysis.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceDisableCrashAnalysis" Tag="LaunchAdvanceDisableCrashAnalysis" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SettingsCard Icon="lucide/memory-stick" Header="{DynamicResource Setup.Launch.Advanced.LockMemory}"
                                Description="{DynamicResource Setup.Launch.Advanced.LockMemory.ToolTip}">
                <local:SymbioCheck Style="{StaticResource SyToggleSwitch}" x:Name="CheckAdvanceLockMemory" Tag="LaunchAdvanceLockMemory" Change="CheckBoxChange" />
            </local:SettingsCard>
            <local:SymbioNotice Text="{DynamicResource Setup.Launch.Advanced.MoreInInstanceSetup}" Margin="0,4,0,0" Theme="Blue"
                                CanClose="True" RelativeSetup="HintMoreAdvancedSetup" />

            <local:ProminentAction HorizontalAlignment="Center" Margin="0,20,0,0"
                                   x:Name="BtnSwitch" Text="{DynamicResource Setup.Launch.SwitchToInstanceSetup}" Click="BtnSwitch_Click"
                                   LogoScale="0.9" SvgIcon="lucide/arrow-right" />
        </StackPanel>
    </ScrollViewer>
</local:WorkspacePage>

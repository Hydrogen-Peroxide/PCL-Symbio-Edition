<Grid x:Class="PCL.TextDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:PCL"
      UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="400"
      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Border Name="PanBorder" CornerRadius="8" Background="{DynamicResource SyFlyoutFill}" BorderBrush="{DynamicResource SySurfaceStroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource SyShadowColor}" BlurRadius="32" ShadowDepth="8" Direction="270"
                              RenderingBias="Performance" Opacity="0.28" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" TextTrimming="None" Foreground="{DynamicResource SyText}"
                       HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="测试标题文本"
                       VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Grid x:Name="CrashBanner" Grid.Row="0" Visibility="Collapsed"
                  MaxWidth="620" MaxHeight="112" Margin="0,4,0,6"
                  HorizontalAlignment="Center" IsHitTestVisible="False"
                  AutomationProperties.Name="{Binding Text, ElementName=LabTitle}">
                <Image x:Name="CrashBannerIcon" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="CrashBannerKicker" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="CrashBannerHeadline" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="Transparent" />
            <ScrollViewer my:ScrollInput.Enabled="True" Style="{StaticResource SyScrollViewer}" Grid.Row="3" VerticalAlignment="Top" x:Name="PanCaption" Margin="0,0,0,17"
                               Padding="7,0,15,0"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                               my:ScrollInput.DeltaMultiplier="0.7">
                <TextBlock VerticalAlignment="Top" TextTrimming="None" TextWrapping="Wrap" Name="LabCaption"
                           FontSize="15" LineHeight="18"
                           Foreground="{DynamicResource SyText}" FontWeight="Normal" Padding="1" />
            </ScrollViewer>
            <StackPanel Grid.Row="4" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="150,0,8,0" Orientation="Horizontal">
                <my:SymbioButton ColorType="Normal" x:FieldModifier="public" Text="测试按钮1" Click="Btn1_Click" x:Name="Btn1"
                             Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                <my:SymbioButton ColorType="Normal" x:FieldModifier="public" Text="测试按钮2" Click="Btn2_Click" x:Name="Btn2"
                             Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                <my:SymbioButton ColorType="Normal" x:FieldModifier="public" Text="测试按钮3" Click="Btn3_Click" x:Name="Btn3"
                             Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>

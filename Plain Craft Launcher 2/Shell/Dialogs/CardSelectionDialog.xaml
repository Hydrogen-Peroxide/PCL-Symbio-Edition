<Grid x:Class="PCL.CardSelectionDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:PCL"
      UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="400"
      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Border Name="PanBorder" CornerRadius="8" Background="{DynamicResource SyFlyoutFill}" BorderBrush="{DynamicResource SySurfaceStroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource SyShadowColor}" BlurRadius="32" ShadowDepth="8" Direction="270"
                              RenderingBias="Performance" Opacity="0.28" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" TextTrimming="None" Foreground="{DynamicResource SyText}"
                       HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="选择加载器"
                       VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="Transparent" />
            <TextBlock Grid.Row="2" Name="LabCaption" Margin="7,13,7,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SyTextSecondary}" />
            <StackPanel Grid.Row="3" Name="PanCards" Margin="7,13,15,0" />
            <StackPanel Grid.Row="4" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="150,17,8,0" Orientation="Horizontal">
                <my:SymbioButton ColorType="Normal" x:FieldModifier="public" Text="确定" x:Name="Btn1" Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                <my:SymbioButton ColorType="Normal" x:FieldModifier="public" Text="取消" x:Name="Btn2" Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>

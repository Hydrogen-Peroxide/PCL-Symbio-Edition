<UserControl x:Class="PCL.MapEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL">
    <UserControl.Resources>
        <!-- 地图区域需要横向滚动，不能直接用只支持纵向的 MyScrollViewer，这里给 ScrollViewer 换一套带深浅配色的模板 -->
        <Style x:Key="MapScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush4}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="BtnDecrease" Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="BtnIncrease" Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{DynamicResource MyThumb}"
                                           Foreground="{TemplateBinding Foreground}" Opacity="0.55" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                                <Setter Property="Width" Value="8" />
                                <Setter Property="MinWidth" Value="8" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="MinHeight" Value="8" />
                                <Setter TargetName="BtnDecrease" Property="Command"
                                        Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="BtnIncrease" Property="Command"
                                        Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MapScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical" Style="{StaticResource MapScrollBarStyle}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal" Style="{StaticResource MapScrollBarStyle}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LabWorld" FontSize="14.5" FontWeight="Bold" MaxWidth="200"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LabSelection" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
                <local:MyComboBox x:Name="ComboDimension" Width="124" Height="26" Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" SelectionChanged="ComboDimension_SelectionChanged">
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.DimensionOverworld}"
                                          Tag="" IsSelected="True" />
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.DimensionNether}"
                                          Tag="DIM-1" />
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.DimensionEnd}"
                                          Tag="DIM1" />
                </local:MyComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <local:MyIconButton x:Name="BtnGrid" SvgIcon="lucide/grid-2x2" Opacity="0.55"
                                    ToolTip="{DynamicResource Instance.Saves.MapEditor.Grid}"
                                    Click="BtnGrid_Click" />
                <local:MyIconButton x:Name="BtnLayer" SvgIcon="lucide/layers" Opacity="0.55"
                                    Margin="8,0,0,0"
                                    ToolTip="{DynamicResource Instance.Saves.MapEditor.Layer}"
                                    Click="BtnLayer_Click" />
                <local:MyIconButton SvgIcon="lucide/circle-minus" ToolTip="{DynamicResource Instance.Saves.MapEditor.ZoomOut}"
                                    Click="BtnZoomOut_Click" />
                <TextBlock x:Name="LabZoom" MinWidth="46" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ColorBrushGray3}" />
                <local:MyIconButton SvgIcon="lucide/circle-plus" ToolTip="{DynamicResource Instance.Saves.MapEditor.ZoomIn}"
                                    Click="BtnZoomIn_Click" />
                <local:MyIconButton SvgIcon="lucide/refresh-cw" ToolTip="{DynamicResource Instance.Saves.MapEditor.Reload}"
                                    Margin="8,0,0,0" Click="BtnReload_Click" />
                <local:MyIconButton SvgIcon="lucide/copy" ToolTip="{DynamicResource Instance.Saves.MapEditor.CopySelected}"
                                    Margin="8,0,0,0" Click="BtnCopy_Click" />
                <local:MyIconButton SvgIcon="lucide/upload" ToolTip="{DynamicResource Instance.Saves.MapEditor.Import}"
                                    Margin="8,0,0,0" Click="BtnImport_Click" />
                <local:MyIconButton SvgIcon="lucide/download" ToolTip="{DynamicResource Instance.Saves.MapEditor.Export}"
                                    Margin="8,0,0,0" Click="BtnExport_Click" />
                <local:MyIconButton x:Name="BtnUndo" SvgIcon="lucide/rotate-ccw"
                                    ToolTip="{DynamicResource Instance.Saves.MapEditor.Undo}"
                                    Margin="8,0,0,0" IsEnabled="False" Click="BtnUndo_Click" />
                <local:MyButton x:Name="BtnDelete" Text="{DynamicResource Instance.Saves.MapEditor.DeleteSelected}"
                                ColorType="Red" Height="32" MinWidth="120" Margin="14,0,0,0" Padding="12,0"
                                Click="BtnDelete_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Instance.Saves.MapEditor.SelectionMode}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray3}" />
                <local:MyButton x:Name="BtnSelectRect" Text="{DynamicResource Instance.Saves.MapEditor.RectSelect}"
                                ColorType="Highlight" Height="26" Padding="10,0" Margin="8,0,0,0"
                                Click="BtnSelectRect_Click" />
                <local:MyButton x:Name="BtnSelectBrush" Text="{DynamicResource Instance.Saves.MapEditor.BrushSelect}"
                                Height="26" Padding="10,0" Margin="6,0,0,0"
                                ToolTip="{DynamicResource Instance.Saves.MapEditor.BrushToolTip}"
                                Click="BtnSelectBrush_Click" />

                <TextBlock Text="{DynamicResource Instance.Saves.MapEditor.Filter}" FontSize="11"
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="{DynamicResource ColorBrushGray3}" />
                <local:MyComboBox x:Name="ComboFilter" Width="118" Height="26" Margin="8,0,0,0"
                                  VerticalAlignment="Center" SelectionChanged="ComboFilter_SelectionChanged">
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.Filter.None}"
                                          Tag="0" IsSelected="True" />
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.Filter.NotFull}"
                                          Tag="1" />
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.Filter.VersionMismatch}"
                                          Tag="2" />
                    <local:MyComboBoxItem Content="{DynamicResource Instance.Saves.MapEditor.Filter.Recent}"
                                          Tag="3" />
                </local:MyComboBox>
                <local:MyButton x:Name="BtnFilterSelect" Text="{DynamicResource Instance.Saves.MapEditor.Filter.SelectMatching}"
                                Height="26" Padding="10,0" Margin="6,0,0,0" IsEnabled="False"
                                Click="BtnFilterSelect_Click" />

                <TextBlock Text="{DynamicResource Instance.Saves.MapEditor.MoveOffset}" FontSize="11"
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="{DynamicResource ColorBrushGray3}" />
                <local:MyTextBox x:Name="TextMoveX" Width="56" Height="26" Margin="8,0,0,0" HintText="X"
                                 ToolTip="{DynamicResource Instance.Saves.MapEditor.MoveXToolTip}" />
                <local:MyTextBox x:Name="TextMoveZ" Width="56" Height="26" Margin="6,0,0,0" HintText="Z"
                                 ToolTip="{DynamicResource Instance.Saves.MapEditor.MoveZToolTip}" />
                <local:MyButton x:Name="BtnMove" Text="{DynamicResource Instance.Saves.MapEditor.Move}"
                                Height="26" Padding="10,0" Margin="6,0,0,0" Click="BtnMove_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ColorBrushGray7}" CornerRadius="8" ClipToBounds="True">
            <ScrollViewer x:Name="PanScroll" Style="{StaticResource MapScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" PanningMode="Both">
                <Grid x:Name="PanMapRoot" HorizontalAlignment="Left" VerticalAlignment="Top"
                      RenderTransformOrigin="0,0">
                    <Canvas x:Name="PanRegions" />
                    <Canvas x:Name="PanGrid" IsHitTestVisible="False" Visibility="Collapsed">
                        <Rectangle x:Name="GridChunk" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#26FFFFFF" Thickness="1" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,4,4" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="GridRegion" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#4DFFFFFF" Thickness="1" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,128,128" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                    <Canvas x:Name="PanFilter" IsHitTestVisible="False" />
                    <Canvas x:Name="PanSelection" IsHitTestVisible="False" />
                    <Canvas x:Name="PanInput" Background="Transparent"
                            MouseLeftButtonDown="PanInput_MouseLeftButtonDown"
                            MouseMove="PanInput_MouseMove"
                            MouseLeftButtonUp="PanInput_MouseLeftButtonUp"
                            MouseLeave="PanInput_MouseLeave"
                            PreviewMouseWheel="PanInput_PreviewMouseWheel" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabStatus" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel x:Name="PanLayer" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed" Margin="0,0,14,0">
                    <TextBlock x:Name="LabLayerTop" FontSize="11" VerticalAlignment="Center" MinWidth="46"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <local:MySlider x:Name="SliderLayer" Width="90" Margin="6,0,0,0" MaxValue="383"
                                    Change="SliderLayer_Change" />
                    <TextBlock x:Name="LabLayerBottom" FontSize="11" VerticalAlignment="Center" MinWidth="46"
                               Margin="10,0,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
                    <local:MySlider x:Name="SliderLayerBottom" Width="90" Margin="6,0,0,0" MaxValue="383"
                                    Change="SliderLayerBottom_Change" />
                </StackPanel>
                <local:MyTextBox x:Name="TextJumpX" Width="66" Height="26"
                                 HintText="{DynamicResource Instance.Saves.MapEditor.JumpX}"
                                 ToolTip="{DynamicResource Instance.Saves.MapEditor.JumpXToolTip}" />
                <local:MyTextBox x:Name="TextJumpZ" Width="66" Height="26" Margin="6,0,0,0"
                                 HintText="{DynamicResource Instance.Saves.MapEditor.JumpZ}"
                                 ToolTip="{DynamicResource Instance.Saves.MapEditor.JumpZToolTip}" />
                <local:MyButton x:Name="BtnJump" Height="26" MinWidth="64" Margin="6,0,0,0" Padding="10,0"
                                Text="{DynamicResource Instance.Saves.MapEditor.Jump}" Click="BtnJump_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
